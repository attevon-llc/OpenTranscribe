{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/routes/**/+{page,layout,error}.{svelte,ts,js}",
    "src/app.html",
    "scripts/**/*.{js,mjs}"
  ],
  "project": ["src/**/*.{ts,js,svelte}"],
  "ignoreDependencies": [],
  "svelte": {
    "config": ["svelte.config.js"]
  },
  "vite": {
    "config": ["vite.config.ts", "vitest.config.ts"]
  }
}
