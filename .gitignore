frontend/static/ffmpeg/
frontend/ffmpeg-wasm-build/dist/
frontend/ffmpeg-wasm-build/test/node_modules/
frontend/ffmpeg-wasm-build/test/package-lock.json

# Private project management files
GITHUB_OPTIMIZATION_TASKS.md

# Keep security reports for transparency
# security-reports/ - intentionally tracked in repo

# PKI test certificates (generated)
scripts/pki/test-certs/

# Claude Code worktrees
.claude/worktrees/
test-results/

# Watch Sources local mount (test/runtime media — issue #26)
/watch/

# Fresh deployment generated compose overlays (opentr.sh --fresh)
.fresh/

# Release orchestrator ledger (scripts/release.sh) — per-release stage state
.release/

# Local test matrix ledger (scripts/test-matrix.sh) — per-run leg state
.test-matrix/

# Legal/licensing planning — internal, not for public repo
.legal/

# Mutation testing (scripts/run-mutation-tests.sh). mutmut 3 copies the source tree
# into backend/mutants/ and mutates the copy; both it and the older cache are
# regenerated on every run and must never be committed.
backend/mutants/
backend/.mutmut-cache
.mutmut-cache
# Run logs + test-list fingerprints. These are the EVIDENCE `--check-baseline` compares
# against scripts/mutation-baselines.tsv (which IS committed). They live in the repo rather
# than /tmp because /tmp is cleared on reboot, which silently disarmed the ratchet.
.mutation/

# Scratch working directory for the #403 RAG epic: cached issues/gists, injection
# manifests, probe scripts and file backups. Never part of the product.
.rag-403/
