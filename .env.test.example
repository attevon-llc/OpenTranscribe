# OpenTranscribe — LOCAL TEST CONTAINERS
#
# ⚠️ DEVELOPMENT ONLY. Every credential below is a published, throwaway value.
#    Never copy any of it into a real deployment.
#
# These configure the disposable identity providers and test services that
# ./opentr.sh can start alongside the dev stack. They configure the TEST
# CONTAINERS, not OpenTranscribe itself — the application's own auth is
# configured in the admin UI (Settings -> Authentication).
#
# Usage: append the block you need to your .env, or export the vars, then start
# the stack with the matching flag. All of these bind to 127.0.0.1 only.
#
#   ./opentr.sh start dev --with-ldap-test
#   ./opentr.sh start dev --with-keycloak-test
#   ./opentr.sh start dev --with-authentik-test
#   ./opentr.sh start dev --with-smb-test
#   ./opentr.sh start dev --with-monitoring
#   ./opentr.sh start prod --build --with-pki
#
# Full walkthrough for each: docs-site/docs/configuration/environment-variables.md

# ── LLDAP (--with-ldap-test) ─────────────────────────────────────────────────
# UI at http://localhost:17170, admin / admin_password
LDAP_TEST_PORT=3890
LDAP_TEST_UI_PORT=17170

# ── Keycloak (--with-keycloak-test) ──────────────────────────────────────────
# http://localhost:8180, admin / admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180

# ── Authentik (--with-authentik-test) ────────────────────────────────────────
# http://localhost:9022, admin@example.com / admin_password
AUTHENTIK_PORT=9022
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=admin_password
AUTHENTIK_SECRET_KEY=dev-test-secret-key-not-for-production
AUTHENTIK_DB_PASSWORD=authentik-test-only

# ── Samba (--with-smb-test) ──────────────────────────────────────────────────
# Exercises the SMB watch-source type. testuser / testpass.
SMB_TEST_PORT=1445

# ── PKI / mTLS (prod only — Vite cannot do mTLS) ─────────────────────────────
# https://localhost:5182. Client certs: scripts/pki/test-certs/clients/*.p12
PKI_HTTPS_PORT=5182
PKI_SERVER_NAME=localhost
STEP_CA_PORT=9000

# ── Prometheus + Grafana (--with-monitoring) ─────────────────────────────────
# Grafana at http://localhost:5185 (admin / the password below).
PROMETHEUS_PORT=5186
GRAFANA_PORT=5185
GRAFANA_PASSWORD=admin

# ── Mock LLM (--with-mock-llm) ───────────────────────────────────────────────
# OpenAI-compatible server at http://mock-llm:5199/v1 — no GPU, key or internet.
# Scenario models: mock-gpt | mock-echo | mock-empty | mock-error | mock-slow |
# mock-reasoning. See backend/tests/CLAUDE.md for what each one exercises.
MOCK_LLM_PORT=5199
