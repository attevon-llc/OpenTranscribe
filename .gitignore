# Frozen test-timing baseline for scripts/analyze-test-timing.py --baseline.
# Deliberately NOT committed: it is a measurement of one machine at one moment, and a
# checked-in copy would rot exactly the way expected-schemas.tsv did. Regenerate with
#   ./scripts/run-backend-tests.sh && cp /tmp/ot-backend-tests/last.xml baseline.xml
baseline.xml

# Test files
test-output/
/screenshots/
# Playwright E2E failure screenshots (auto-saved by backend/tests/e2e/conftest.py)
backend/tests/e2e/screenshots/
# Visual-regression failure captures (the .png baselines in __screenshots__/ ARE tracked)
backend/tests/e2e/__screenshots__/*.actual.png
videos/
test_videos/
# Allow documentation screenshots
!docs-site/static/img/screenshots/

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej

# AI model downloads (runtime only)
/backend/models/
/models/
*.bin
*.safetensors
*.gguf

# Media upload testing
/uploads/
/test_uploads/
uploads/
downloads/
# Anchored, like /uploads/ and /test_uploads/ above. Unanchored, `media/` matched a directory
# named `media` at ANY depth, which silently swallowed backend/tests/fixtures/media/ — small
# committed audio/transcript fixtures the suite needs. It was protecting nothing: no
# root-level media/ exists, and the only other match is inside venv/ (already ignored).
/media/

# Security and SSL certificates
*.pem
*.key
*.crt
*.csr
secrets/
nginx/ssl/*.crt
nginx/ssl/*.key

# Package files
*.deb
*.rpm
*.msi
*.dmg
*.AppImage

# Archived releases (root-level only; docs/releases/ is tracked)
/releases/
*.tar.gz
*.zip
*.rar

# Local configuration overrides
local_config.py
local_settings.py
config.local.json

# Process files
*.pid
*.seed
*.pid.lock

# Documentation build
docs/_build/
docs/build/

# Profiling data
*.prof

# Container runtime data
.dockerignore.local

# Monitoring and metrics (runtime data dirs). The monitoring/ stack CONFIG
# (Prometheus scrape config, Grafana provisioning + dashboards) is the
# version-controlled monitoring overlay and must be tracked — un-ignore it.
metrics/
monitoring/
!monitoring/
!monitoring/**/

# Backup files
*.sql.bak
*.db.bak
dump.rdb

# System and temporary files
.system
.tmp/
.temp/

