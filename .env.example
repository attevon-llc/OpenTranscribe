# OpenTranscribe — environment template
#
# Copy to .env and replace every CHANGE_ME. The installers generate secrets for you.
#
# THIS FILE IS FOR SECRETS AND SYSTEM CONFIG ONLY.
# Auth, ASR/LLM providers, redaction policy and watch sources are configured in
# the ADMIN UI and stored in the database — a UI value always wins over this file.
# Everything below AUTHENTICATION METHODS / AI PROVIDERS / CLOUD ASR PROVIDERS is a
# .env FALLBACK for that same reason: it only matters until an admin sets the
# equivalent value in the UI, and exists so a deployment can be scripted/bootstrapped
# without ever opening it.
#
# Every variable, its default, and the optional settings NOT listed here:
#   docs-site/docs/configuration/environment-variables.md
# Local test containers (LDAP/Keycloak/Authentik/monitoring):  .env.test.example

#--- SECRETS — replace every CHANGE_ME before exposing this deployment ---------
POSTGRES_PASSWORD=CHANGE_ME_auto_generated_on_install
# production REFUSES TO BOOT if unset
REDIS_PASSWORD=CHANGE_ME_auto_generated_on_install
MINIO_ROOT_PASSWORD=CHANGE_ME_auto_generated_on_install
# ./opentr.sh replaces this placeholder with a real <name>:<base64-32-bytes>
# key on first `start`/`reset` if it's still unchanged — required format for
# MinIO KMS auto-encryption (MINIO_KMS_AUTO_ENCRYPTION=on below); see the
# minio service in docker-compose.yml for the format and how to generate one
# by hand.
MINIO_KMS_SECRET_KEY=CHANGE_ME_auto_generated_on_install
OPENSEARCH_PASSWORD=CHANGE_ME_auto_generated_on_install
OPENSEARCH_ADMIN_PASSWORD=
# production REFUSES TO BOOT on the placeholder
JWT_SECRET_KEY=CHANGE_ME_auto_generated_on_install
# decrypts every DB-stored secret — NEVER change after first use
ENCRYPTION_KEY=CHANGE_ME_auto_generated_on_install
FLOWER_PASSWORD=CHANGE_ME_auto_generated_on_install
HUGGINGFACE_TOKEN=
SMTP_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

#--- CORE SERVICES -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_DB=opentranscribe
POSTGRES_SSLMODE=prefer
# Full connection string override. Empty (default) assembles it from the
# POSTGRES_* values above; set this instead to point at an external managed
# Postgres (e.g. RDS with a non-default sslmode/query string) that the
# individual POSTGRES_* fields can't express.
DATABASE_URL=
REDIS_HOST=redis
REDIS_USE_TLS=false
# required | optional | none — only applies when REDIS_USE_TLS=true
CELERY_REDIS_SSL_CERT_REQS=required
# 6h — must exceed the longest job or a still-running task gets redelivered and double-run
CELERY_VISIBILITY_TIMEOUT=21600
# 3h — prefork/CPU queues only; unreliable under the GPU workers' --pool=threads
CELERY_SOFT_TIME_LIMIT=10800
# 3h15m — must exceed CELERY_SOFT_TIME_LIMIT
CELERY_HARD_TIME_LIMIT=11700
# Full connection string override, same rationale as DATABASE_URL — e.g. Redis
# Sentinel/Cluster URLs that REDIS_HOST/REDIS_PASSWORD/REDIS_USE_TLS can't express.
# Empty (default) assembles redis(s)://[:password@]REDIS_HOST:REDIS_PORT/0.
REDIS_URL=
MINIO_HOST=minio
MINIO_ROOT_USER=minioadmin
MINIO_SECURE=false
MEDIA_BUCKET_NAME=opentranscribe
MINIO_KMS_AUTO_ENCRYPTION=on
OPENSEARCH_HOST=opensearch
OPENSEARCH_USER=admin
OPENSEARCH_USE_TLS=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_AUTH=basic
OPENSEARCH_AWS_REGION=
OPENSEARCH_AWS_SERVICE=es
OPENSEARCH_DISABLE_SECURITY=true
# JVM heap for the OpenSearch container. LOW-RAM MACHINES: -Xms2g -Xmx2g is
# verified to run; keep the two values equal (no heap resizing at runtime).
OPENSEARCH_JAVA_OPTS="-Xms4g -Xmx4g"
# Master on/off switch for OpenSearch-backed indexing/search. false disables
# search and RAG chat retrieval entirely; not a normal deployment choice.
OPENSEARCH_ENABLED=true

#--- POSTGRES TUNING (advanced) — defaults suit a small/medium single-node box -
# PG_MAX_CONNECTIONS must stay comfortably above the sum of every service's
# DB_POOL_SIZE + DB_MAX_OVERFLOW (API + every worker), or the pool itself
# starts failing to connect under load.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_MAX_CONNECTIONS=200
# SQLAlchemy pool for the FastAPI backend process only — Celery workers build
# their own engines, sized by WORKER_DB_POOL_SIZE/WORKER_DB_MAX_OVERFLOW below.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
# Postgres kills a backend connection that is idle IN a transaction (not idle,
# and not running a query) for this long — defence in depth against a held-open
# transaction blocking VACUUM. 0 disables. See core/config.py for the full
# rationale (issue #440).
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
# Per-worker-container pool size (each Celery worker gets its own, much smaller
# than the API's DB_POOL_SIZE/DB_MAX_OVERFLOW above).
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=3

#--- PORTS (host-side) ---------------------------------------------------------
# Web UI
FRONTEND_PORT=5173
# API Server
BACKEND_PORT=5174
# Host interface the API port binds to. 0.0.0.0 (the default) publishes it on
# every interface, including the LAN; 127.0.0.1 restricts it to this machine so
# only a reverse proxy in front of it is reachable. `--with-pki` forces
# 127.0.0.1 regardless of this value, because a header-asserted certificate DN
# is trusted from the proxy's network and the backend port must not be a way
# around that proxy (issue #620).
BACKEND_BIND_HOST=0.0.0.0
# Celery Task Monitor
FLOWER_PORT=5175
# Database (for admin tools)
POSTGRES_PORT=5176
# Redis (for debugging)
REDIS_PORT=5177
# MinIO API
MINIO_PORT=5178
# MinIO Web Console
MINIO_CONSOLE_PORT=5179
# OpenSearch API
OPENSEARCH_PORT=5180
# OpenSearch Admin
OPENSEARCH_ADMIN_PORT=5181
# Embedded documentation site (proxied at /docs/ in-app)
DOCS_PORT=5183

#--- RELEASE PINNING -----------------------------------------------------------
# The release tag every service image resolves: docker-compose.prod.yml declares
# `image: davidamacey/opentranscribe-<svc>:${OT_IMAGE_TAG:-latest}` for all of them, so this
# ONE line pins backend, frontend, docs and every celery worker together. That is why there is
# no per-service image setting to keep in sync.
#
# Optional — commented out on purpose. setup-opentranscribe.sh uncomments it with the release
# it resolved, and `./opentranscribe.sh update --version vX.Y.Z` / `--rollback` rewrite it (the
# previous value is recorded beside it as a commented `# OT_PREVIOUS_IMAGE_TAG=`). Leave it
# alone unless you are pinning by hand; absent behaves exactly like `latest`.
#OT_IMAGE_TAG=latest

#--- STORAGE -------------------------------------------------------------------
STORAGE_BACKEND=minio
MINIO_PUBLIC_URL=
STORAGE_PUBLIC_URL=
# 6h
MEDIA_URL_EXPIRE_SECONDS=21600
# Thumbnail presigned URLs — shorter-lived than media URLs since they're small,
# static images re-requested often.
THUMBNAIL_URL_EXPIRE_SECONDS=900
# 6h
PRESIGNED_URL_MAX_SECONDS=21600
MULTIPART_THRESHOLD_MB=512
MODEL_CACHE_DIR=./models
# --with-benchmark overlay: 1 skips HuggingFace network calls (models must
# already be cached). The offline/airgapped overlay hardcodes this itself.
HF_HUB_OFFLINE=0
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_USE_IAM_ROLE=true
S3_CONFIGURE_BUCKET_CORS=false
S3_CORS_ALLOWED_ORIGINS=
# shared cross-worker scratch volume for WAV handoff
PIPELINE_SCRATCH_DIR=/scratch/opentranscribe
# false on multi-node deployments where workers do NOT share a filesystem
PIPELINE_SCRATCH_SHARED=true
# Days to keep regenerable derived assets (subtitle-burned videos, extracted
# audio) before a MinIO lifecycle rule expires them. 0 = keep forever. Baseline
# only — the admin UI (DB) overrides it live.
DERIVED_CACHE_RETENTION_DAYS=7

#--- SEARCH --------------------------------------------------------------------
OPENSEARCH_NEURAL_SEARCH_ENABLED=true
# changing this forces a FULL REINDEX
OPENSEARCH_NEURAL_MODEL=huggingface/sentence-transformers/all-MiniLM-L6-v2
OPENSEARCH_NEURAL_PIPELINE=transcript-neural-ingest
OPENSEARCH_EMBEDDING_MODE=local
OPENSEARCH_NEURAL_MODEL_ID=
# Index topology — applied ONLY at index CREATION. Do not change the defaults
# here; shards cannot change on a live index without a full reindex, and
# replicas > 0 on a single-node box leave every replica shard permanently
# UNASSIGNED (yellow status). See docs-site deployment-configuration.md.
OPENSEARCH_CHUNKS_INDEX_SHARDS=1
OPENSEARCH_CHUNKS_INDEX_REPLICAS=0
# Chunking + hybrid-fusion tuning (issue #363). Env-only by design — these are
# measurement knobs for the retrieval A/B, not admin settings.
SEARCH_CHUNK_TARGET_WORDS=200
SEARCH_CHUNK_OVERLAP_WORDS=40
SEARCH_RRF_RANK_CONSTANT=30
SEARCH_RRF_WINDOW_SIZE=500
# rrf | normalization
SEARCH_FUSION_STRATEGY=rrf
SEARCH_NORMALIZATION_TECHNIQUE=min_max
SEARCH_COMBINATION_TECHNIQUE=arithmetic_mean
# e.g. "0.7,0.3" (BM25, neural); empty = equal
SEARCH_COMBINATION_WEIGHTS=
SEARCH_BULK_BATCH_SIZE=100
SEARCH_NEURAL_BATCH_SIZE=5
SEARCH_REINDEX_REFRESH_INTERVAL=100
REINDEX_PARALLEL_WORKERS=4
SEARCH_HYBRID_MIN_SCORE=0.005
SEARCH_SEMANTIC_HIGH_CONFIDENCE=0.010
# 0.5 = keep top half of semantic-only results
SEARCH_SEMANTIC_SUPPRESS_RATIO=0.20
# concurrent group searches for collapse inner_hits
SEARCH_COLLAPSE_MAX_CONCURRENT=20
# over-fetch ceiling for client-side sort of collapsed groups
SEARCH_MAX_OVERFETCH=1000
# chunk-count threshold for temporarily disabling refresh during bulk index
SEARCH_LARGE_TRANSCRIPT_CHUNKS=500

#--- GPU AND TRANSCRIPTION -----------------------------------------------------
# which physical GPU to use
GPU_DEVICE_ID=0
GPU_CONCURRENT_REQUESTS=1
GPU_SCALE_ENABLED=false
GPU_SCALE_DEVICE_ID=2
GPU_SCALE_WORKERS=4
GPU_SCALE_DEFAULT_WORKER=1
# celery --pool for the gpu-scale worker container
GPU_SCALE_POOL=threads
# celery --max-tasks-per-child for the gpu-scale worker container
GPU_SCALE_MAX_TASKS=500
# host CUDA device for gpu-transcribe worker (WhisperX)
GPU_TRANSCRIBE_DEVICE_ID=0
# host CUDA device for gpu-diarize worker (PyAnnote)
GPU_DIARIZE_DEVICE_ID=1
FFMPEG_THREADS=0
# also settable in the admin UI, which wins
WHISPER_MODEL=large-v3-turbo
ENABLE_DIARIZATION=true
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
MIN_SPEAKERS=1
# Can be increased to 50+ for large conferences (no hard limit)
MAX_SPEAKERS=20
# Force an EXACT speaker count, overriding MIN/MAX_SPEAKERS. Leave empty to use the range.
NUM_SPEAKERS=
ENABLE_VRAM_PROFILING=false
DEPLOYMENT_MODE=full
BACKEND_LITE_IMAGE=davidamacey/opentranscribe-backend-lite:latest
# faster_whisper | whisperx | cloud
ENGINE_TRANSCRIBER_BACKEND=faster_whisper
# native (Rust/ONNX sidecar, faster and better on AMI) | pyannote (in-process fork).
# The backend exports the sidecar's weights on first startup, so `native` needs no
# setup beyond HUGGINGFACE_TOKEN above. If that export cannot run the pipeline falls
# back to PyAnnote automatically, so this value is safe to leave as-is either way.
ENGINE_DIARIZER_BACKEND=native
ENGINE_GPU_SPLIT=false
# internal cross-stage WAV handoff dir (engine/ namespace of the pipeline_scratch volume)
ENGINE_SHARED_VOLUME_PATH=/scratch/opentranscribe/engine
# force CPU-only even when a GPU is present
FORCE_CPU_MODE=false
# true | false | auto — CPU transcription + GPU/MPS diarization
WHISPER_HYBRID_MODE=auto
# Escape hatch: false forces speaker voiceprints back onto the in-process PyAnnote model.
# When true (the default) v4/256-d embeddings come from diarization centroids, or from the
# diar-native sidecar when a separate extraction is needed — the same weights either way.
# v3/512-d installs always use the in-process model regardless; see issue #571.
USE_NATIVE_SPEAKER_EMBEDDINGS=true
# 0 forces sequential transcribe-then-diarize (debug escape hatch)
DIAR_OVERLAP=1
# mark overlapping-speech segments when diarization reports overlap regions
ENABLE_OVERLAP_DETECTION=true
# override pyannote's auto-computed segmentation batch size
DIARIZATION_BATCH_SIZE=
# divisor for "auto" CPU worker concurrency (cpu_count // this)
CPU_WORKER_CONCURRENCY=8
# celery --pool for GPU workers; prefork recycles a worker's CUDA context between tasks
GPU_WORKER_POOL=threads
# native diarization sidecar
DIAR_NATIVE_URL=http://diar-native:8701
# dir shared (bind/volume) between this worker and the sidecar (diar/ namespace of the
# pipeline_scratch volume; the sidecar's own-copy fallback)
DIAR_NATIVE_SHARED_DIR=/scratch/opentranscribe/diar
# request timeout to the sidecar
DIAR_NATIVE_TIMEOUT_S=3600
# ask the sidecar for gender alongside diarization
DIAR_NATIVE_GENDER=1
# cuda | mps | cpu. Leave unset: the compose overlays pick cpu, or cuda with the GPU
# overlay. Setting it here overrides both, which breaks a CPU-only host.
#DIAR_NATIVE_MODE=
# --with-diar-native overlay: max concurrent diarization requests the sidecar accepts
DIAR_NATIVE_MAX_INFLIGHT=2
# --with-diar-native overlay: 1 = lazily load models on first request instead of at startup
DIAR_NATIVE_LAZY_SESSIONS=1
# --with-scratch-tmpfs overlay: RAM-backed pipeline_scratch size, sized off
# DIAR_NATIVE_MAX_INFLIGHT x 2 x largest_file (the x2 is the own-copy fallback transiently
# holding both the engine/-linked name and its own diar/ copy at once, worst case)
#SCRATCH_TMPFS_SIZE=2g
# Pin the diar-native sidecar to a specific GPU. Leave unset to inherit GPU_DEVICE_ID —
# it holds ~2.2 GB of warm ORT arena once warm, so moving it off is a deliberate choice.
#DIAR_NATIVE_GPU=
# Host dir holding the sidecar's exported ONNX/PLDA weights (backend writes, sidecar
# reads). Defaults to ${MODEL_CACHE_DIR}/diar-native. Set only to reuse an export
# you keep elsewhere. On a lite (DEPLOYMENT_MODE=lite) install this is the ONLY way
# to populate /models: the lite image ships no Python exporter toolchain, so point
# this at an export produced by a full install or another host.
#DIAR_NATIVE_MODELS_DIR=./models/diar-native
# Pin the sidecar image explicitly, e.g. to pair it with a lite deployment
# (davidamacey/opentranscribe-backend-lite:latest) or a blackwell build. Leave
# unset to use the overlay's coded default (the full backend image).
#DIAR_NATIVE_IMAGE=
# The weights are exported on first backend startup (~484 MB, ~140 s, then cached) using
# HUGGINGFACE_TOKEN above, with the terms accepted at
# https://huggingface.co/pyannote/speaker-diarization-community-1 by that same account.
# Set false only on multi-replica deploys, where a job should own the export instead.
#DIAR_NATIVE_AUTO_PROVISION=true
# fast (default) | small (laptop tier)
#DIAR_NATIVE_MODEL_SET=fast
# bounds a hung export — mostly download time, so deliberately generous
#DIAR_NATIVE_PROVISION_TIMEOUT_S=1800
# sidecar log level, and text | json for the structured per-request records
#DIAR_NATIVE_LOG_LEVEL=info
#DIAR_NATIVE_LOG_FORMAT=text
# how long a /readyz result is reused before re-probing. Deliberately short: a recovered
# sidecar and an admin engine toggle must both take effect without a worker restart.
#DIAR_NATIVE_READY_CACHE_TTL_S=3
# Hardware auto-detection overrides — "auto" (default) detects CUDA/MPS/CPU and
# an appropriate compute type/batch size at runtime. Force a value only to work
# around a detection bug or to pin CPU-only behavior explicitly.
# auto | cuda | mps | cpu
TORCH_DEVICE=auto
# auto | float16 | float32 | int8
COMPUTE_TYPE=auto
# auto or an integer
BATCH_SIZE=auto
# WhisperX VAD: minimum silence gap (ms) to split segments
VAD_MIN_SILENCE_MS=2000
# Celery worker tuning — concurrency / batch size / max tasks before a worker
# process recycles (bounds slow memory growth from ML model state).
GPU_MAX_TASKS=100000
GPU_DEFAULT_BATCH_SIZE=auto
CLOUD_ASR_CONCURRENCY=16
NLP_CONCURRENCY=4
NLP_MAX_TASKS=50
DOWNLOAD_CONCURRENCY=5
DOWNLOAD_MAX_TASKS=10

#--- AI PROVIDERS — per-user config lives in the UI; these are only the fallback
LLM_PROVIDER=
# MUST be true for local vLLM/Ollama; false on multi-tenant
LLM_ALLOW_PRIVATE_ENDPOINTS=false
ASR_PROVIDER=local
# Same policy as LLM_ALLOW_PRIVATE_ENDPOINTS above, kept separate so one can be on
# without the other. Gates a cloud ASR config's base_url (e.g. a self-hosted Gladia
# stand-in) and GLADIA_API_BASE_URL alike.
ASR_ALLOW_PRIVATE_ENDPOINTS=false
AWS_REGION=us-east-1
# Quick-access defaults for common LLM providers (per-user config in the UI wins).
VLLM_BASE_URL=http://localhost:8012/v1
VLLM_MODEL_NAME=gpt-oss
VLLM_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama2:7b-chat
ANTHROPIC_MODEL_NAME=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=
OPENROUTER_MODEL_NAME=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Amazon Bedrock — no API key: boto3 resolves credentials via the standard AWS
# chain (instance/task role, profile, env). Region falls back to AWS_REGION. Both
# a per-user config (Settings -> LLM Provider -> AWS Bedrock) and this system
# fallback need BEDROCK_REGION set; without it Bedrock is treated as unconfigured.
BEDROCK_MODEL_NAME=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=

#--- CLOUD ASR PROVIDERS — per-user config lives in the UI; these are the fallback
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal
OPENAI_ASR_MODEL=gpt-4o-transcribe
# path to a service-account JSON file
GOOGLE_CLOUD_CREDENTIALS=
GOOGLE_ASR_MODEL=chirp-3
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_ASR_MODEL=whisper
AWS_ASR_MODEL=standard
AWS_TRANSCRIBE_BUCKET=
SPEECHMATICS_API_KEY=
SPEECHMATICS_MODEL=standard
GLADIA_API_KEY=
GLADIA_MODEL=standard
# Deployment-config override for the Gladia API base URL — empty = real API
# (https://api.gladia.io). Only for pointing at a stand-in server in testing.
GLADIA_API_BASE_URL=

#--- AUTHENTICATION METHODS — configurable here or in Settings -> Authentication
# (DB config always wins). Every method below defaults OFF; local username/
# password auth (LOCAL_AUTH_ENABLED) works out of the box with no setup.
LOCAL_AUTH_ENABLED=true
# Bootstrap super_admin. In production, leaving the password empty generates a
# strong random one (logged once at startup) instead of a known credential.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
# REQUIRE_ACCOUNT_APPROVAL=false   # true = new/JIT-provisioned accounts need admin approval before login

# ===== LDAP / Active Directory =====
# LDAP_ENABLED=false
# LDAP_SERVER=                              # e.g. ldaps://ldap.example.com
# LDAP_PORT=636
# LDAP_USE_SSL=true                         # LDAPS (636); mutually exclusive with LDAP_USE_TLS
# LDAP_USE_TLS=false                        # StartTLS on the non-SSL port (389)
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_SEARCH_BASE=
# LDAP_USERNAME_ATTR=sAMAccountName
# LDAP_USER_SEARCH_FILTER="({username_attr}={username})"
# LDAP_EMAIL_ATTR=mail
# LDAP_NAME_ATTR=cn
# LDAP_TIMEOUT=10
# LDAP_ADMIN_USERS=                         # comma-separated usernames granted admin
# LDAP_ADMIN_GROUPS=                        # comma-separated group DNs granted admin
# LDAP_USER_GROUPS=                         # comma-separated group DNs required for access; empty = allow all
# LDAP_RECURSIVE_GROUPS=false               # nested group membership (LDAP_MATCHING_RULE_IN_CHAIN)
# LDAP_GROUP_ATTR=memberOf

# ===== OpenID Connect ===== (each also accepts its historical KEYCLOAK_* spelling)
# OIDC_ENABLED=false
# OIDC_SERVER_URL=                          # e.g. http://localhost:8180
# OIDC_INTERNAL_URL=                        # backend-to-provider URL (Docker networking); falls back to OIDC_SERVER_URL
# OIDC_REALM=opentranscribe
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CALLBACK_URL=                        # SPA route, e.g. http://localhost:5173/login
# OIDC_ADMIN_ROLE=admin
# OIDC_TIMEOUT=30
# OIDC_VERIFY_AUDIENCE=true
# OIDC_AUDIENCE=
# OIDC_USE_PKCE=true
# OIDC_VERIFY_ISSUER=true
# Generic discovery (issue #353) — without it, endpoints are built from
# OIDC_SERVER_URL + a realm-shaped path, which most non-Keycloak providers 404 on.
# OIDC_DISCOVERY_URL=
# OIDC_ISSUER=
# OIDC_ROLES_CLAIM=realm_access.roles       # dotted path; Authentik/Okta: groups, Entra ID: roles
# OIDC_SCOPES="openid email profile"
# EMPTY ALLOW-LIST ADMITS EVERYONE (upgrade-safe default). Blocked wins over allowed.
# OIDC_ALLOWED_GROUPS=
# OIDC_BLOCKED_GROUPS=

# ===== SAML 2.0 =====
# SAML_ENABLED=false
# SAML_SP_ENTITY_ID=
# SAML_SP_ACS_URL=                          # must exactly match what's registered with the IdP
# SAML_SP_SLS_URL=
# SAML_SP_X509_CERT=                        # only needed if this SP signs/decrypts (PEM)
# SAML_SP_PRIVATE_KEY=
# SAML_IDP_ENTITY_ID=
# SAML_IDP_SSO_URL=
# SAML_IDP_SLO_URL=
# SAML_IDP_X509_CERT=                       # the IdP's signing cert (PEM) — required to verify assertions
# SAML_WANT_ASSERTIONS_SIGNED=true
# SAML_WANT_MESSAGES_SIGNED=true
# SAML_SIGN_AUTHN_REQUESTS=false
# SAML_EMAIL_ATTRIBUTE=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress
# SAML_NAME_ATTRIBUTE=http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name
# SAML_GROUPS_ATTRIBUTE=groups
# SAML_ADMIN_GROUP=
# SAML_ALLOWED_GROUPS=                      # EMPTY ADMITS EVERYONE, same as OIDC_ALLOWED_GROUPS
# SAML_BLOCKED_GROUPS=

# ===== Trusted-header (reverse-proxy) auth =====
# PROXY_EMAIL_HEADER=X-Forwarded-Email
# PROXY_NAME_HEADER=X-Forwarded-User
# PROXY_GROUPS_HEADER=                      # no default: reading an unconfigured header would grant privilege nobody set
# PROXY_GROUPS_SEPARATOR=,
# PROXY_ROLE_HEADER=                        # opt-in, capped at 'admin'
# PROXY_SHARED_SECRET=                      # defence in depth: proxy must send this in X-OpenTranscribe-Proxy-Secret
# PROXY_ALLOWED_DOMAINS=                    # comma-separated email domain allowlist; empty admits every domain
# PROXY_JIT_PROVISIONING=true

# ===== PKI / mTLS (client certificates) =====
# PKI_CA_CERT_PATH=                         # required when PKI_VERIFY_REVOCATION=true
# PKI_VERIFY_REVOCATION=false               # OCSP/CRL revocation checking
# PKI_CERT_HEADER=X-Client-Cert
# PKI_CERT_DN_HEADER=X-Client-Cert-DN
# PKI_ADMIN_DNS=                            # SEMICOLON-separated admin cert DNs — a DN itself
# contains commas, so ',' cannot delimit multiple entries (ldap_auth._parse_group_list)
# PKI_OCSP_TIMEOUT_SECONDS=5
# PKI_CRL_CACHE_SECONDS=3600
# Soft-fail lets auth succeed when a revocation check itself fails (network
# issue). Defaults strict (false) in production; dev relaxes to true.
# PKI_REVOCATION_SOFT_FAIL=false

#--- SECURITY ------------------------------------------------------------------
# FAIL-CLOSED: unset or unknown = production
# ENVIRONMENT=production
# true (default) self-hosts; false for K8s/ECS where a migrate Job owns migrations
# RUN_MIGRATIONS_ON_STARTUP=true
# A hardened deployment sets Secure on every auth cookie, which requires real
# HTTPS -- a browser silently drops a Secure cookie sent over plain HTTP to
# anything other than localhost/127.0.0.1, so a homelab/small-business install
# reached over a plain-HTTP LAN IP (e.g. http://10.10.10.20:5173) will appear to
# log in successfully and then never hold a session. Set true ONLY for that
# case: a single-tenant deployment on a trusted LAN with no TLS-terminating
# reverse proxy in front. It does not relax anything else (secrets, rate
# limits, lockout, DEBUG stay enforced). Put a real reverse proxy with TLS
# (even a self-signed cert trusted on your devices) in front instead whenever
# that's an option, and leave this false for anything reachable from an
# untrusted network, including a cloud/EC2 deployment.
# ALLOW_INSECURE_COOKIES=false
# 15 GB, matching the UI. 0 disables the limit.
# MAX_UPLOAD_BYTES=16106127360
# false when an IdP owns identity. DB-backed at Settings -> Authentication.
# ALLOW_OPEN_REGISTRATION=true
JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# SESSION_IDLE_TIMEOUT_MINUTES=15
# SESSION_ABSOLUTE_TIMEOUT_MINUTES=480
# MAX_CONCURRENT_SESSIONS=5                 # 0 = unlimited
# CONCURRENT_SESSION_POLICY=terminate_oldest  # or "reject"
RATE_LIMIT_API_PER_MINUTE=100
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_ENABLED=true
# leave empty unless you add your own proxy
RATE_LIMIT_TRUSTED_PROXIES=
# REQUIRED in production — every mailed credential link is built from it
FRONTEND_URL=http://localhost:5173
ABUSE_CONTACT_EMAIL=
PKI_ENABLED=false
# empty = reject every header identity (fail-closed boot guard)
PKI_TRUSTED_PROXIES=
PROXY_ENABLED=false
# empty = reject every header identity (fail-closed boot guard)
PROXY_TRUSTED_PROXIES=
PKI_OCSP_CACHE_MAX_SIZE=1000
PKI_CRL_CACHE_MAX_SIZE=1000
# publish Swagger/OpenAPI/ReDoc; a hardened deployment hides them unless opted back in
# ENABLE_API_DOCS=true
# declare this deployment airgapped; skip NLTK download attempts entirely
# NLTK_OFFLINE=true

# ===== Password Policy (FedRAMP IA-5) =====
# PASSWORD_POLICY_ENABLED=true
# PASSWORD_MIN_LENGTH=12
# PASSWORD_REQUIRE_UPPERCASE=true
# PASSWORD_REQUIRE_LOWERCASE=true
# PASSWORD_REQUIRE_DIGIT=true
# PASSWORD_REQUIRE_SPECIAL=true
# PASSWORD_HISTORY_COUNT=24                 # previous passwords remembered (FedRAMP: 24)
# PASSWORD_MAX_AGE_DAYS=60                  # forced reset interval (FedRAMP: 60)

# ===== Account Lockout (NIST AC-7) =====
# ACCOUNT_LOCKOUT_ENABLED=true
# ACCOUNT_LOCKOUT_THRESHOLD=5
# ACCOUNT_LOCKOUT_DURATION_MINUTES=15
# ACCOUNT_LOCKOUT_PROGRESSIVE=true          # doubles duration on each subsequent lockout
# ACCOUNT_LOCKOUT_MAX_DURATION_MINUTES=1440

# ===== Login Banner (FedRAMP AC-8) =====
# LOGIN_BANNER_ENABLED=false
# LOGIN_BANNER_TEXT=
# LOGIN_BANNER_CLASSIFICATION=UNCLASSIFIED

# ===== Multi-Factor Auth (FedRAMP IA-2) =====
# MFA_ENABLED=false                         # off by default for air-gapped deployments
# MFA_REQUIRED=false                        # force MFA setup on first login
# MFA_ISSUER_NAME=OpenTranscribe
# MFA_BACKUP_CODE_COUNT=10
# MFA_TOKEN_EXPIRE_MINUTES=5
# accepted time steps before/after (clock drift)
TOTP_VALID_WINDOW=1
# Require Redis for MFA replay protection (fail-secure). Empty = hardened
# posture in production, permissive in dev/test (see core/config.py).
MFA_REQUIRE_REDIS=

#--- COMPLIANCE — env-only by necessity; see the docs for what each enforces ---
FIPS_MODE=false
# "140-2" or "140-3"; governs password hashing only
FIPS_VERSION=140-3
# "compatible" or "strict"
FIPS_MIGRATION_MODE=compatible
FIPS_VALIDATE_ENTROPY=true
PBKDF2_ITERATIONS=210000
# NIST SP 800-132 2024, used when FIPS 140-3 is active
PBKDF2_ITERATIONS_V3=600000
# additionally accepted verification algorithm under FIPS 140-3
JWT_ALGORITHM_V3=HS512
# SHA1 | SHA256 | SHA512 (SHA1 for authenticator-app compatibility)
TOTP_ALGORITHM=SHA1
TOKEN_REVOCATION_ENABLED=true
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FORMAT=json
AUDIT_LOG_TO_OPENSEARCH=true
AUDIT_LOG_RETENTION_DAYS=365
# Fallback to file-based audit logging when OpenSearch is unavailable (FedRAMP AU-9)
AUDIT_LOG_FALLBACK_ENABLED=true
AUDIT_LOG_FALLBACK_PATH=/var/log/opentranscribe/audit-fallback.jsonl
# FedRAMP AC-2: deactivate an account after this many days with no login. Off by default.
ACCOUNT_EXPIRATION_ENABLED=false
ACCOUNT_INACTIVE_DAYS=90

#--- MAIL — prefer the Admin UI (Settings -> Watch Sources -> Email Configurations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

#--- REDACTION — worker/model hosting only; policy is set in the UI ------------
# auto | cpu | cuda — compute device for redaction ML models
REDACTION_DEVICE=auto
# spare GPU id for redaction models when REDACTION_DEVICE=cuda
REDACTION_GPU_DEVICE_ID=
# free-VRAM floor before redaction worker uses GPU
REDACTION_MIN_FREE_VRAM_GB=1.5
# redaction worker concurrency
REDACTION_CONCURRENCY=2
# celery --pool for the redaction worker
REDACTION_WORKER_POOL=threads
# max-tasks-per-child before the redaction worker process recycles
REDACTION_MAX_TASKS=200
# caps OMP/MKL threads for the redaction worker
REDACTION_TORCH_THREADS=8
# OS nice priority for the redaction worker
REDACTION_NICE=10
# use GLiNER for PII NER (slower, more accurate) vs spaCy NER
REDACTION_PII_USE_GLINER=false
# PII-detection worker pool size; empty = auto (cpu_count - 1, capped)
REDACTION_PII_WORKERS=

#--- WATCH SOURCES — most settings are DB-backed via the Admin UI; these two are
#--- infrastructure knobs the UI itself relies on -------------------------------
# Temp dir for downloaded/stitched watch-source files; empty falls back to TEMP_DIR.
WATCH_TEMP_DIR=
# SSRF egress policy for watch-source S3 endpoints / SMB servers, same rationale
# as LLM_ALLOW_PRIVATE_ENDPOINTS above. Defaults ON: a self-hosted NAS on the LAN
# is the normal case for a single-tenant install. Turn OFF for multi-tenant or
# publicly-registerable deployments.
WATCH_ALLOW_PRIVATE_ENDPOINTS=true

#--- YOUTUBE INGESTION ---------------------------------------------------------
YOUTUBE_COOKIE_BROWSER=
YOUTUBE_COOKIE_FILE=
YOUTUBE_PLAYLIST_STAGGER_ENABLED=true
# Minimum delay between videos
YOUTUBE_PLAYLIST_STAGGER_MIN_SECONDS=5
# Maximum delay (caps at this value)
YOUTUBE_PLAYLIST_STAGGER_MAX_SECONDS=30
# Delay increases by this amount per video
YOUTUBE_PLAYLIST_STAGGER_INCREMENT=5
YOUTUBE_PRE_DOWNLOAD_JITTER_ENABLED=true
# Minimum random delay
YOUTUBE_PRE_DOWNLOAD_JITTER_MIN_SECONDS=2
# Maximum random delay
YOUTUBE_PRE_DOWNLOAD_JITTER_MAX_SECONDS=15
YOUTUBE_USER_RATE_LIMIT_ENABLED=true
# Maximum downloads per user per hour
YOUTUBE_USER_RATE_LIMIT_PER_HOUR=50
# Maximum downloads per user per day
YOUTUBE_USER_RATE_LIMIT_PER_DAY=500
YOUTUBE_RECOVERY_BATCH_SIZE=3
YOUTUBE_AUTO_RETRY_ENABLED=true
YOUTUBE_DOWNLOAD_RATE_LIMIT=30/h

#--- FRONTEND ------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5174/api
VITE_FLOWER_URL_PREFIX=flower
FLOWER_USER=admin
FLOWER_URL_PREFIX=flower

#--- LOGGING -------------------------------------------------------------------
LOG_FORMAT=text
SLOW_QUERY_MS=500
SETTINGS_CACHE_TTL=30
READ_CACHE_ENABLED=true

#--- HOST PATHS — only used by the matching ./opentr.sh --with-* overlay -------
WATCH_HOST_PATH=./watch
# Opt into the scheduled-backup overlay (docker-compose.backup.yml) on a production
# install. Commented out by default: the overlay also sets path.repo on the opensearch
# service, so enabling it RECREATES that container on the next start/update.
# ./opentr.sh uses its own --with-backup flag instead and ignores this key.
#BACKUP_OVERLAY_ENABLED=true
BACKUP_HOST_PATH=./backups
# --with-blackwell overlay: HOST-side scratch dir bind-mounted to the
# in-container /app/temp (the base stack's own TEMP_DIR, hardcoded internally
# and not user-configurable — do not confuse the two).
TEMP_DIR_HOST=./temp
# --nas overlay: media file storage on NAS. Commented out by default — a
# non-empty value here auto-enables NAS-overlay detection (see opentr.sh's
# add_nas_overlay), which then hard-fails if the path isn't actually mounted.
# That bit an example-only environment (CI copies this file to .env verbatim,
# issue #597) as much as it would a real deployment with a stale path.
# Uncomment and set to your own NAS mount to opt in.
# MINIO_NAS_PATH=/mnt/nas/opentranscribe-minio
# --nas overlay: database storage, typically local NVMe for latency
# POSTGRES_DATA_PATH=/mnt/nvm/opentranscribe/pg
# --nas overlay: search index storage, typically local NVMe for latency
# OPENSEARCH_DATA_PATH=/mnt/nvm/opentranscribe/os

#--- OPTIONAL OVERLAYS — host ports/paths for less-common ./opentr.sh --with-* /
#--- -f overlays; unused unless that overlay is loaded ------------------------
# docker-compose.lite.yml: image pull policy for the cloud-only lite deployment
PULL_POLICY=always
# docker-compose.nginx.yml: reverse-proxy host ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# docker-compose.nginx.yml: TLS cert/key paths mounted into the nginx container
NGINX_CERT_FILE=./nginx/ssl/server.crt
NGINX_CERT_KEY=./nginx/ssl/server.key
# docker-compose.pki-dev.yml: step-ca ACME HTTP challenge port
PKI_HTTP_PORT=5187
# docker-compose.monitoring.yml: Prometheus UI
PROMETHEUS_PORT=5186
# docker-compose.monitoring.yml: Grafana UI
GRAFANA_PORT=5185
# docker-compose.monitoring.yml: Grafana admin password — CHANGE IN PRODUCTION
GRAFANA_PASSWORD=admin
# Compose project name — load-bearing for `./opentr.sh start dev --fresh`, which
# re-pins every service/volume under a project-scoped name. Left unset normally;
# opentr.sh derives a default from the directory name if you don't set it.
# COMPOSE_PROJECT_NAME=
BACKUP_MIRROR_HOST_PATH=./media-mirror
