# OpenTranscribe .gitignore

.github/DRAFT_ISSUES/
offline-package-build/
OT_TEST/
opentranscribe/
reference_repos/
benchmark/
benchmarks/
benchmark_thorough_*.json

# Raw per-level benchmark data (large CSV timelines + per-run dirs). Keep only the
