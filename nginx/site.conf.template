# OpenTranscribe NGINX Configuration Template
# Environment variables are substituted at container startup via envsubst
#
# Required: NGINX_SERVER_NAME (e.g., transcribe.local, transcribe.example.com)

# HTTP server - redirect all traffic to HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${NGINX_SERVER_NAME};

    # Health check endpoint for Docker healthcheck (no redirect)
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Redirect all other HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server - main application
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    # SSL/TLS Configuration
    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Hide NGINX version in response headers and error pages
    server_tokens off;

    # Security Headers (OWASP recommendations)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "0" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; media-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self';" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # File upload size limit (for audio/video transcription)
    # Supports files up to 10GB for large GoPro/4K recordings
    client_max_body_size 10G;
    client_body_timeout 600s;
    client_body_buffer_size 256k;

    # Common proxy settings applied to all locations
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # Embedded documentation site (served from docs container)
    # Allows offline/corporate users to read docs without leaving the app
    location /docs/ {
        proxy_pass http://docs:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Frontend SPA (Svelte application)
    # Handles all routes not matched by other locations
    # Internal container port is 8080 (external host port is 5173)
    location / {
        proxy_pass http://frontend:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # SPA routing - let frontend handle 404s for client-side routes
        proxy_intercept_errors off;
    }

    # Backend WebSocket endpoint (real-time notifications)
    # IMPORTANT: Must be defined BEFORE /api/ to match first
    location /api/ws {
        proxy_pass http://backend:8080/api/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # WebSocket-specific timeouts
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        # Disable buffering for real-time communication
        proxy_buffering off;
    }

    # Backend SSE download stream (Server-Sent Events for async downloads)
    # IMPORTANT: Must be defined BEFORE /api/ so the regex matches first.
    # SSE requires buffering OFF so progress/ready events reach the browser
    # immediately instead of being held until the response closes.
    location ~ ^/api/files/(.+/download-stream|bulk-export-stream)$ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # Backend REST API
    location /api/ {
        proxy_pass http://backend:8080/api/;
        proxy_http_version 1.1;

        # Large file upload support for audio/video (10GB for GoPro/4K files)
        client_max_body_size 10G;
        proxy_request_buffering off;

        # Extended timeouts for long transcription operations
        proxy_read_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
    }

    # Flower dashboard (Celery task monitoring)
    location /flower/ {
        proxy_pass http://flower:5555/flower/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_redirect off;

        # Inject Flower Basic Auth credentials automatically so users don't see
        # a browser auth dialog when opening the dashboard from the app UI.
        # FLOWER_AUTH_B64 is computed at nginx startup as base64(FLOWER_USER:FLOWER_PASSWORD).
        proxy_set_header Authorization "Basic ${FLOWER_AUTH_B64}";

        # WebSocket/SSE support for Flower's real-time task event stream
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_buffering off;
    }

    # MinIO Console (S3 storage management)
    location /minio/ {
        proxy_pass http://minio:9001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # MinIO requires these for proper console operation
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for MinIO console
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # MinIO API endpoint (for presigned URLs and direct S3 operations)
    location /s3/ {
        proxy_pass http://minio:9000/;
        proxy_http_version 1.1;

        # IMPORTANT: MinIO presigned URLs are signed with 'minio:9000' as the host
        # Must match exactly what the minio_client was initialized with
        proxy_set_header Host "minio:9000";

        # Large file uploads to MinIO (10GB for GoPro/4K files)
        client_max_body_size 10G;
        proxy_request_buffering off;

        # Stream large media downloads straight through instead of buffering them
        # to temp files (presigned video/audio downloads can be multi-GB).
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
