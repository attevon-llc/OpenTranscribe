# OpenTranscribe .gitignore

.github/DRAFT_ISSUES/
offline-package-build/
OT_TEST/
opentranscribe/
reference_repos/
benchmark/
benchmarks/
benchmark_thorough_*.json

# Raw per-level benchmark data (large CSV timelines + per-run dirs). Keep only the
# collated top-level summaries (results.tsv, master_results.csv, summary.md, README.md).
docs/engine-benchmark-results/*/

# Papers (unpublished — remove from gitignore when ready to release)
docs/performance-whitepaper/
docs/research-paper/
PLANS/

# Environment variables
.env
.env.local
.env.production
.env.prod
.env.development
.env.test
.env.*.local

# Release-test secrets (template at .env.test-secrets.example is committed)
scripts/release-tests/.env.test-secrets

# Release-test sandbox runs (created by scripts/release-tests/*.sh)
opentranscribe-test-runs/

# Docker bind-mount stubs (created by OCI runtime when host path doesn't exist)
# Occurs because ./backend:/app and ./VERSION:/app/VERSION:ro overlap in dev compose
backend/VERSION

