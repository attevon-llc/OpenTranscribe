# =============================================================================
# OpenTranscribe Backend - Lite Dockerfile (API-only, no GPU required)
# Multi-stage build for cloud-only ASR deployments. MEASURED 2026-09-04 on this host:
# 2.70 GB, vs 15.2 GB for the full image. (The previous "~2 GB vs 8.9 GB" was stale on
# both halves — re-measure with `docker image ls` rather than trusting this line.)
# No faster-whisper, no ctranslate2, no CUDA — uses cloud ASR providers instead.
#
# It DOES carry pyannote.audio + the ONNX export toolchain, which looks contradictory for
# a "lite" image and is not: the diar-native sidecar reads ONNX/PLDA graphs that are
# non-redistributable derivatives of gated weights, so there is nothing to download and a
# lite deployment must EXPORT them for itself or have no speaker-voiceprint path at all.
#
# ⚠️ "Lite" means NO GPU/CUDA/faster-whisper — it does NOT mean "as small as possible".
# Nothing in this repo gates on the size of this image (no test, no script, no CI job), and
# #660's own title is "--lite adopts the diar-native CPU execution provider for speaker
# embeddings" — a capability goal. If a tool is required for lite to work, it ships. Chasing
# megabytes here has already cost real functionality once: the toolchain was removed as
# "unused at runtime" (true) without noticing it was the only way to CREATE the models
# (2.38 GB and no voiceprint path at all), and the restore then shipped without
# `onnxruntime`, which the exporter imports unguarded — an image that still could not
# provision, at 2.62 GB.
#
# So verify the CAPABILITY, never the size:
#   docker run --rm --entrypoint diar-server <image> provision-models --models-dir /tmp/m \
#     --mode cpu --json
# must reach exit 5 (TOKEN_DENIED) with no token supplied. A dependency failure means the
# toolchain is incomplete however small the image is. (For reference only, measured
# 2026-09-04: 2.70 GB. Not a budget, not a target.)
# =============================================================================

# diar-native (T1 diarization sidecar) binary + ONNX Runtime CPU-provider libs.
# ⚠️ Pre-#680 bug: this stage pinned the SAME digest as Dockerfile.prod:21 — the CUDA
# standalone image (tag 0.3.1) — despite the comment above (now corrected) claiming
# CPU-provider libs. That happened to still "work" on amd64 only because the COPY below
# cherry-picks specific files out of a CUDA-capable image, and there was no arm64 leg at
# all: BuildKit does not error on a --platform linux/arm64 build against a single-arch
# amd64 base (issue #680) — COPY --from succeeds and only running the copied ELF fails,
# with "exec format error" at container start. Fixed by selecting the real per-arch
# diar-native CPU tag via TARGETARCH, still pinned by digest so the binary is
# reproducible — just the correct (CPU) image, and now built for both architectures.
ARG TARGETARCH
FROM davidamacey/diar-native@sha256:b00b4bb5999d0b5cc353dae27c07b17fe61b232517f250aaf3ef03536c610879 AS diar-native-bin-amd64
FROM davidamacey/diar-native@sha256:63e7a7275aada3da8c4840cbc5e2b4e498605a6658086355c62b84af75232d64 AS diar-native-bin-arm64
# This FROM selects one of the two DIGEST-PINNED stages immediately above by ARG
# TARGETARCH; hadolint cannot trace that indirection and flags it as an untagged
# external image, but it resolves to one of the two pinned FROMs on this same
# page, never a floating tag.
# hadolint ignore=DL3006
FROM diar-native-bin-${TARGETARCH} AS diar-native-bin

# -----------------------------------------------------------------------------
# Stage 1: Build Stage - Install Python dependencies with compilation
# -----------------------------------------------------------------------------
FROM python:3.13-slim-trixie AS builder

WORKDIR /build

# Install build dependencies (only in this stage)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first for better layer caching
COPY requirements-lite.txt .

# Upgrade pip to latest version first (security fix for CVE-2025-8869)
RUN pip install --user --no-cache-dir --upgrade pip

# Install Python dependencies (CPU-only, no CUDA packages)
# Use --user to install to /root/.local which we'll copy to final stage
RUN pip install --user --no-cache-dir --no-warn-script-location -r requirements-lite.txt

# -----------------------------------------------------------------------------
# Stage 2: Runtime Stage - Minimal production image with non-root user
# -----------------------------------------------------------------------------
FROM python:3.13-slim-trixie

# Make CUDA ordinals match nvidia-smi, NVML and Docker's `device_ids` (issue #719).
# Harmless on this CPU-only image, and kept identical to Dockerfile.prod so the
# lite/CUDA pair cannot drift on device selection if lite ever gains a GPU path.
#
# Deliberately kept HERE while the identity ARGs moved down past the app COPY (#667):
# this value is constant, so it costs no cache; APP_VERSION/GIT_SHA/BUILD_TIME change
# every build and would invalidate everything below them from this position.
ENV CUDA_DEVICE_ORDER=PCI_BUS_ID

# OCI annotations for container metadata and compliance
LABEL org.opencontainers.image.title="OpenTranscribe Backend Lite" \
      org.opencontainers.image.description="Cloud-only ASR backend (no GPU required) with multi-provider support" \
      org.opencontainers.image.vendor="OpenTranscribe" \
      org.opencontainers.image.authors="OpenTranscribe Contributors" \
      org.opencontainers.image.licenses="AGPL-3.0" \
      org.opencontainers.image.source="https://github.com/attevon-llc/OpenTranscribe" \
      org.opencontainers.image.documentation="https://github.com/attevon-llc/OpenTranscribe/blob/master/README.md"

# Install only runtime dependencies (no build tools, no CUDA libraries)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    libsndfile1 \
    libimage-exiftool-perl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# diar-native's only extra system dependency: libopenblas0 (linked by diar-server itself,
# per `ldd` — see Dockerfile.prod). Its own dependency libgfortran5 is pulled in
# transitively by apt automatically if not already present; unlike the full image, this
# lite image has no scipy in requirements-lite.txt, so — unlike Dockerfile.prod's verified
# "already present" claim — it is NOT assumed present here and this step may pull it in.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas0 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
# No video group needed (no GPU access required in lite mode)
RUN groupadd -r appuser && \
    useradd -r -g appuser -u 1000 -m -s /bin/bash appuser && \
    mkdir -p /app /app/models /app/temp && \
    chown -R appuser:appuser /app && \
    mkdir -p /home/appuser/.cache/huggingface \
             /home/appuser/.cache/torch \
             /home/appuser/.cache/nltk_data \
             /home/appuser/.cache/sentence-transformers \
             /home/appuser/.cache/yt-dlp && \
    chown -R appuser:appuser /home/appuser/.cache

# Set working directory
WORKDIR /app

# Copy Python packages from builder stage
COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local

# diar-native binary + ONNX Runtime CPU-provider libs (#660). Adapted from
# Dockerfile.prod's equivalent block — read that one first, this is NOT a blind copy:
#   - No libonnxruntime_providers_cuda.so: lite has no CUDA runtime to load it against,
#     and the CPU execution provider needs no separate provider .so.
#   - No image-wide LD_LIBRARY_PATH here, same as Dockerfile.prod: a compose-level
#     LD_LIBRARY_PATH scoped to just the diar-native SERVICE is what points at
#     /opt/diar-native/lib (see docker-compose.diar-native.yml) — never image-wide, so it
#     can never collide with a Python onnxruntime install's own same-named provider libs.
#   - No `video` group step needed here either — this image already has none (no GPU
#     access in lite mode), and the CPU provider needs none.
# /opt/diar-native/run is diar-server's working_dir (compose-level); chowned to appuser
# for the same reason Dockerfile.prod chowns it — nothing writes there today, but it is
# the one place a future write-relative-to-cwd would land.
RUN mkdir -p /opt/diar-native/lib /opt/diar-native/run && chown appuser:appuser /opt/diar-native/run
COPY --from=diar-native-bin --chown=appuser:appuser /usr/local/bin/diar-server /usr/local/bin/diar-server
COPY --from=diar-native-bin --chown=appuser:appuser /usr/local/lib/libonnxruntime.so.1.24.2 /opt/diar-native/lib/libonnxruntime.so.1.24.2
COPY --from=diar-native-bin --chown=appuser:appuser /usr/local/lib/libonnxruntime_providers_shared.so /opt/diar-native/lib/libonnxruntime_providers_shared.so
# The 26 s verification clip `provision-models` diarizes in its end-to-end stage —
# same rationale and source as Dockerfile.prod's identical COPY.
COPY --from=diar-native-bin --chown=appuser:appuser /usr/local/share/diar-native/smoke.wav /usr/local/share/diar-native/smoke.wav
# ORT resolves its provider libs relative to the executable's directory AND the process
# cwd (diar-server has no ELF NEEDED entry for libonnxruntime — it's dlopen'd at
# runtime), so the shared provider lib is symlinked into both locations, same as
# Dockerfile.prod. Only the shared provider needs this — there is no cuda provider here
# to symlink.
RUN ln -s /opt/diar-native/lib/libonnxruntime_providers_shared.so /usr/local/bin/libonnxruntime_providers_shared.so && \
    ln -s /opt/diar-native/lib/libonnxruntime_providers_shared.so /opt/diar-native/run/libonnxruntime_providers_shared.so && \
    chown -h appuser:appuser /opt/diar-native/run/libonnxruntime_providers_shared.so

# Ensure scripts in .local are usable by adding to PATH
# No LD_LIBRARY_PATH needed (no CUDA/cuDNN in lite mode)
# Set cache directories to user home
# PYTHONPATH: /app must be importable by any interpreter in this image, not just the
# Celery CLI (which injects cwd at runtime, in-process). Subprocesses that exec a fresh
# interpreter -- notably multiprocessing's forkserver -- inherit the environment but not
# sys.path, and without this they fail with ModuleNotFoundError: No module named 'app'.
ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/home/appuser/.cache/huggingface \
    TRANSFORMERS_CACHE=/home/appuser/.cache/huggingface/transformers \
    TORCH_HOME=/home/appuser/.cache/torch \
    NLTK_DATA=/home/appuser/.cache/nltk_data \
    SENTENCE_TRANSFORMERS_HOME=/home/appuser/.cache/sentence-transformers \
    DEPLOYMENT_MODE=lite

# Copy application code
COPY --chown=appuser:appuser . .

# Build identity, baked in so /version, /health and /system/stats can report what this
# image actually is without a repo checkout. version.py resolves file -> env -> "unknown",
# and the build context is ./backend, so the repo-root VERSION file is NOT in the image —
# these three ENVs are the only source a running lite container has for its own identity.
# All three are passed by scripts/docker-build-push.sh's build_backend_identity_args().
#
# Until this block existed, Dockerfile.lite declared APP_VERSION alone: buildx warned
# ("InvalidDefaultArgInFrom"/unconsumed build arg) on the other two and every published
# lite image reported GIT_SHA=unknown, BUILD_TIME=unknown from GET /version. Dockerfile.prod
# has carried all three since #680.
#
# ⚠️ POSITION IS LOAD-BEARING — keep this AFTER the `COPY . .` above, never at the top of
# the runtime stage where APP_VERSION used to sit. GIT_SHA and BUILD_TIME change on EVERY
# build, and an ENV layer invalidates the whole remainder of its stage. Higher up, they
# re-ran apt-get, the useradd, and the ~GB `COPY --from=builder /root/.local` on every
# single build. Nothing below reads them at build time — they are consumed at RUNTIME by
# app/core/version.py — so position affects only cache reuse. Same rationale, and the same
# placement relative to the app COPY, as backend/Dockerfile.prod.
ARG APP_VERSION=unknown
ENV APP_VERSION=${APP_VERSION}
ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}
ARG BUILD_TIME=unknown
ENV BUILD_TIME=${BUILD_TIME}

# Reserve the pipeline's shared-volume mount point so a freshly created named volume
# inherits appuser rather than root — see Dockerfile.prod for the full note (issue #661 E2:
# one volume, pipeline_scratch, three namespaces). This image DOES ship the diar-server
# binary (see the COPY block above, issue #660), so this reservation is live here too.
# Since #654, requirements-lite.txt also RESTORED the export toolchain (torch/torchaudio/
# onnx/onnxscript/onnxslim/onnxconverter-common) — this image can export its own ONNX/PLDA
# weights exactly like the full image, and "lite cannot export it locally" is a dead claim.
RUN mkdir -p /scratch/opentranscribe && \
    chown appuser:appuser /scratch/opentranscribe
RUN mkdir -p /scratch/opentranscribe/engine /scratch/opentranscribe/diar && \
    chown appuser:appuser /scratch/opentranscribe/engine /scratch/opentranscribe/diar

# Switch to non-root user
USER appuser

# Expose application port
EXPOSE 8080

# Health check to verify the application is responding
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Command to run the application in production (no reload)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080"]
