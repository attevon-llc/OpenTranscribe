{
  "name": "opentranscribe-frontend",
  "private": true,
  "version": "0.5.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prebuild": "node scripts/download-fonts.js && node scripts/build-ffmpeg.js",
    "postbuild": "node scripts/check-built-csp.mjs && node scripts/check-bundle-budget.mjs && node scripts/precompress.mjs",
    "build:analyze": "node scripts/download-fonts.js && node scripts/build-ffmpeg.js && ANALYZE=true vite build && node -e \"require('fs').copyFileSync('.bundle-stats/stats.html','dist/stats.html')\" && echo \"bundle report: dist/stats.html\"",
    "deadcode": "knip",
    "cycles": "madge --circular --extensions ts,js,svelte --ts-config tsconfig.json src",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "setup-fonts": "node scripts/download-fonts.js",
    "pretest": "svelte-kit sync",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:ui": "NODE_OPTIONS=--no-experimental-webstorage vitest --ui",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "test:audit": "node scripts/audit-frontend-tests.mjs",
    "test:audit:selftest": "node scripts/audit-frontend-tests.mjs --selftest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@svelte-plugins/datepicker": "^1.0.11",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "madge": "^8.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "svelte": "~5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-range-slider-pips": "^4.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "murmurhash3js-revisited": "^3.0.0",
    "plyr": "^3.8.5",
    "svelte-multiselect": "^11.8.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "serialize-javascript": "^7.0.3"
  }
}
