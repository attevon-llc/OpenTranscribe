# OpenTranscribe Environment Configuration
#
# SECURITY NOTICE: This is a template file with placeholder values.
# DO NOT use these placeholder values in production!
#
# For new installations:
# - Linux/Mac: ./setup-opentranscribe.sh will auto-generate secure passwords
# - Windows: The installer will auto-generate secure passwords
# - Manual: Copy this file to .env and replace ALL placeholder values
#
# All secrets are auto-generated during installation for maximum security.
# You can customize values in .env after installation if needed.

#=============================================================================
# DATABASE CONFIGURATION
#=============================================================================

# PostgreSQL Database Settings
POSTGRES_HOST=postgres
# (declared in APPLICATION PORTS below — keep the value there)
# POSTGRES_PORT=5176
POSTGRES_USER=postgres
# CRITICAL: Auto-generated during install (32-char random hex)
POSTGRES_PASSWORD=CHANGE_ME_auto_generated_on_install
POSTGRES_DB=opentranscribe
# PostgreSQL TLS: disable/allow/prefer/require/verify-ca/verify-full
POSTGRES_SSLMODE=prefer

# Full connection string override. Read by config.py, but auto-constructed from the
# POSTGRES_* settings above by default — set this only for a non-standard connection
# (e.g. a DSN option no POSTGRES_* var exposes). Leave unset in the normal case.
# DATABASE_URL=postgresql://user:pass@host:port/db

# Database initialization is handled by Alembic migrations on backend startup.
# No external SQL init file is needed.

#=============================================================================
# OBJECT STORAGE (MinIO S3-Compatible)
#=============================================================================

# MinIO Storage Settings
MINIO_HOST=minio
# (declared in APPLICATION PORTS below — keep the value there)
# MINIO_PORT=5178
# MINIO_CONSOLE_PORT=5179
# CRITICAL: Auto-generated during install (32-char random hex)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_auto_generated_on_install
MEDIA_BUCKET_NAME=opentranscribe
# Use HTTPS for MinIO connections (requires MinIO TLS configuration)
MINIO_SECURE=false

# MinIO Server-Side Encryption at Rest (AES-256-GCM)
# Automatically encrypts all new objects stored in MinIO. Transparent to the application.
# Existing unencrypted objects remain readable after enabling.
# Format: <key-name>:<base64-encoded-32-byte-key>
# Generate with: echo "opentranscribe-key:$(openssl rand -base64 32)"
# Auto-generated during install. Leave empty to disable encryption at rest.
MINIO_KMS_SECRET_KEY=CHANGE_ME_auto_generated_on_install
# Set to 'on' to enable auto-encryption (requires MINIO_KMS_SECRET_KEY)
MINIO_KMS_AUTO_ENCRYPTION=on

# Public URL for presigned URLs (how browsers access MinIO)
# Dev: Leave empty - defaults to http://localhost:5178
# Prod with nginx: Set to your public MinIO URL
# Example: MINIO_PUBLIC_URL=https://yourdomain.com/minio
# Example: MINIO_PUBLIC_URL=https://minio.yourdomain.com
MINIO_PUBLIC_URL=

# Backend-agnostic alias for MINIO_PUBLIC_URL. Wins over it when both are set.
# Empty (the default) keeps today's behaviour: presigned URLs are rewritten onto the
# /s3 proxy path on the MinIO backend, and left untouched on the s3 backend.
STORAGE_PUBLIC_URL=

# How long presigned media/download URLs stay valid (seconds). Default: 21600 (6h).
MEDIA_URL_EXPIRE_SECONDS=21600   # 6h

# Hard ceiling on EVERY presigned URL, in seconds. Default 21600 (6h) — unchanged
# behaviour for MinIO, where nothing asks for more. A presigned URL dies with the
# credentials that signed it: under an IAM role those are STS session credentials
# (1-12h), so a longer URL silently starts returning 403. Requests above the ceiling
# are clamped and logged, never rejected.
PRESIGNED_URL_MAX_SECONDS=21600  # 6h

# How long presigned thumbnail URLs stay valid (seconds). Default 900 (15m) —
# shorter than media URLs since thumbnails are small static images.
# THUMBNAIL_URL_EXPIRE_SECONDS=900

# Object size (MB) at or above which the browser uploads in presigned parts instead of
# one presigned PUT. Multipart is mandatory above the backend's single-PUT ceiling
# (5 GiB on native S3, 5 TiB on MinIO) and this value can never raise the threshold past
# it; below the ceiling multipart is what makes an interrupted upload resumable.
MULTIPART_THRESHOLD_MB=512

#-----------------------------------------------------------------------------
# Native AWS S3 backend (optional — leave everything below at its default for
# the bundled MinIO container, which is the standard self-hosted setup)
#-----------------------------------------------------------------------------

# minio (default) = the bundled MinIO container, using MINIO_* above.
# s3              = real AWS S3 (or another S3-compatible provider via S3_ENDPOINT_URL).
STORAGE_BACKEND=minio

# Explicit S3 endpoint. Leave EMPTY on AWS to derive https://s3.<S3_REGION>.amazonaws.com,
# which is what selects virtual-host addressing (https://<bucket>.s3.<region>.amazonaws.com)
# and the correct SigV4 signing host. Set it only for a non-AWS provider.
# Example: S3_ENDPOINT_URL=https://s3.wasabisys.com
S3_ENDPOINT_URL=

# SigV4 signing region — must match the bucket's real region or every request fails
# with AuthorizationHeaderMalformed. Falls back to AWS_REGION when unset.
S3_REGION=us-east-1

# true (default) resolves credentials through the AWS chain: env vars, EKS/IRSA web
# identity, ECS task role, then EC2 instance metadata. No static keys, automatic
# rotation. Set false to sign with the static AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# pair defined in the ASR section below.
S3_USE_IAM_ROLE=true

# Apply a browser-upload CORS policy to the media bucket at startup. Only meaningful on
# the s3 backend (MinIO already answers any origin). OFF by default because overwriting
# a bucket's CORS configuration is destructive and the bucket may be shared — prefer
# managing it in your infrastructure-as-code.
S3_CONFIGURE_BUCKET_CORS=false
# Comma-separated origins allowed to PUT directly to the bucket. Empty = reuse CORS_ORIGINS.
# Example: S3_CORS_ALLOWED_ORIGINS=https://transcribe.example.com
S3_CORS_ALLOWED_ORIGINS=

# NOTE — uploads larger than 5 GiB on the s3 backend: AWS rejects a single PUT above
# 5 GiB, so /files/prepare withholds the presigned URL for those and the browser falls
# back to uploading through the API, which writes to S3 with multipart (64 MiB parts).
# MinIO's single-PUT limit is 5 TiB, so this never applies to the default backend.

# Auto-expiry (days) for derived media assets (waveforms, clips, bulk-export ZIPs).
# DB/admin-UI overridable; this is the coded default.
# DERIVED_CACHE_RETENTION_DAYS=7

# Custom Storage Paths (Optional - used with docker-compose.nas.yml overlay)
# Bind-mount data directories to specific disks for optimal performance
# Usage: add -f docker-compose.nas.yml to your docker compose command
#
# MinIO media storage → NAS (high capacity)
# MINIO_NAS_PATH=/mnt/nas/opentranscribe-minio
#
# PostgreSQL database → NVMe (fast random I/O)
# POSTGRES_DATA_PATH=/mnt/nvm/opentranscribe/pg
#
# OpenSearch indices → NVMe (fast indexing and vector search)
# OPENSEARCH_DATA_PATH=/mnt/nvm/opentranscribe/os

#=============================================================================
# REDIS CACHE & MESSAGE BROKER
#=============================================================================

# Redis Configuration
REDIS_HOST=redis
# (declared in APPLICATION PORTS below — keep the value there)
# REDIS_PORT=5177
# OPTIONAL: Set a password for Redis (recommended for production)
# Auto-generated during install (32-char random hex)
# Leave empty to disable Redis authentication (not recommended for production)
REDIS_PASSWORD=CHANGE_ME_auto_generated_on_install
# Use rediss:// (TLS) for Redis connections (requires Redis TLS configuration)
REDIS_USE_TLS=false

# Full connection string override, also used to build CELERY_BROKER_URL /
# CELERY_RESULT_BACKEND. Auto-constructed from the REDIS_* settings above by
# default — set this only for a non-standard connection. Leave unset normally.
# REDIS_URL=redis://:password@host:port/0

#=============================================================================
# SEARCH ENGINE (OpenSearch)
#=============================================================================

# Master toggle for OpenSearch-backed features (search, RAG chat, speaker matching).
# Default true. Only meaningful for a deployment that deliberately runs without the
# opensearch container; leave at the default otherwise.
# OPENSEARCH_ENABLED=true

# JVM heap for the bundled OpenSearch container (its own -Xms/-Xmx flags, read by
# the OpenSearch entrypoint itself, not by the backend). Default: -Xms4g -Xmx4g.
# Raise for a large corpus; keep Xms == Xmx to avoid heap-resize pauses.
# OPENSEARCH_JAVA_OPTS=-Xms4g -Xmx4g

# OpenSearch Configuration
OPENSEARCH_HOST=opensearch
# (declared in APPLICATION PORTS below — keep the value there)
# OPENSEARCH_PORT=5180
# OPENSEARCH_ADMIN_PORT=5181
# OpenSearch credentials (security plugin disabled by default in dev)
# Enable for production by setting OPENSEARCH_SECURITY_ENABLED=true
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=CHANGE_ME_auto_generated_on_install
# Production security: enable TLS + security plugin for OpenSearch
# Use HTTPS for OpenSearch client connections
OPENSEARCH_USE_TLS=false
# Verify TLS certificates (set true for production with valid certs)
OPENSEARCH_VERIFY_CERTS=false

# How to authenticate to OpenSearch.
#   basic (default) = OPENSEARCH_USER / OPENSEARCH_PASSWORD, what the bundled container wants.
#   sigv4           = AWS SigV4 signing from the IAM-role chain — the only auth an Amazon
#                     OpenSearch Service domain with an IAM access policy accepts.
# With sigv4, set OPENSEARCH_HOST to the domain endpoint and OPENSEARCH_PORT=443; TLS and
# certificate verification are forced on regardless of the two settings above.
OPENSEARCH_AUTH=basic
# Signing region for sigv4. Empty falls back to AWS_REGION.
OPENSEARCH_AWS_REGION=
# Signing service name: "es" for a managed domain, "aoss" for OpenSearch Serverless.
OPENSEARCH_AWS_SERVICE=es
# Set to "false" to enable the OpenSearch security plugin (maps to DISABLE_SECURITY_PLUGIN)
OPENSEARCH_DISABLE_SECURITY=true
# OPENSEARCH_ADMIN_PASSWORD: ONLY used when the OpenSearch security plugin is
# enabled (OPENSEARCH_SECURITY_ENABLED=true / OPENSEARCH_DISABLE_SECURITY=false).
# Leave blank when security is disabled (the dev default). OpenSearch enforces
# password complexity (>=8 chars with upper+lower+digit+special), so the
# installers generate a compliant value automatically.
OPENSEARCH_ADMIN_PASSWORD=

# OpenSearch Neural Search (Semantic/Vector Search)
OPENSEARCH_NEURAL_SEARCH_ENABLED=true
OPENSEARCH_NEURAL_MODEL=huggingface/sentence-transformers/all-MiniLM-L6-v2
OPENSEARCH_NEURAL_PIPELINE=transcript-neural-ingest
# Where the embedding model comes from.
#   local (default) = we configure ML Commons and register/deploy OPENSEARCH_NEURAL_MODEL
#                     in the cluster. Requires a cluster you administer.
#   managed         = the domain already hosts the model (typically a remote-model
#                     connector). We touch no cluster settings and download nothing;
#                     set OPENSEARCH_NEURAL_MODEL_ID to the registered model id.
# A managed AWS domain rejects "local": registering a model from a file:// or arbitrary
# https:// URL needs cluster settings AWS does not expose.
OPENSEARCH_EMBEDDING_MODE=local
# Pre-registered ML Commons model id, used only when OPENSEARCH_EMBEDDING_MODE=managed.
OPENSEARCH_NEURAL_MODEL_ID=
# Available models (change after setup via Admin UI or by editing this file):
#   Fast (384d):     all-MiniLM-L6-v2 (default, 80MB, English)
#                    paraphrase-multilingual-MiniLM-L12-v2 (420MB, 50+ langs)
#   Balanced (768d): all-mpnet-base-v2 (420MB, English)
#                    paraphrase-multilingual-mpnet-base-v2 (1.1GB, 50+ langs)
#   Best quality:    all-distilroberta-v1 (768d, 290MB, English)
#                    distiluse-base-multilingual-cased-v1 (512d, 480MB, 15 langs)

# Index topology for the transcript_chunks index — applied ONLY when the index is
# CREATED (fresh install, or a --fresh deployment). OpenSearch cannot change a live
# index's shard count in place, and nothing in this app recreates the index to pick
# up a new value (that means deleting it). Defaults are the single-node topology and
# are correct for laptop/home-server. On a managed multi-node AWS domain, replicas
# are worth setting (>=1, for availability across nodes); on a single-node box a
# replica > 0 leaves every replica shard permanently UNASSIGNED (index status
# yellow) because there is no second node to place it on. See
# docs-site/docs/operations/deployment-configuration.md's AWS profile section.
# OPENSEARCH_CHUNKS_INDEX_SHARDS=1
# OPENSEARCH_CHUNKS_INDEX_REPLICAS=0

# Search Performance: Collapse Optimization
# OpenSearch groups results by file server-side using collapse + inner_hits.
# Max concurrent group searches for collapse inner_hits (default: 20, 0 = sequential)
# SEARCH_COLLAPSE_MAX_CONCURRENT=20

# Search Indexing Performance Tuning
# Bulk batch size: number of chunks per OpenSearch bulk request (default: 100)
# Lower values reduce per-request latency; higher values improve throughput
# SEARCH_BULK_BATCH_SIZE=100
# Neural ingest pipeline batch size: documents batched per embedding call (default: 5)
# SEARCH_NEURAL_BATCH_SIZE=5
# Reindex refresh interval: trigger a Lucene segment flush every N files (default: 100)
# Keeps search results fresh during large reindex operations
# SEARCH_REINDEX_REFRESH_INTERVAL=100
# Large-transcript threshold: bulk loads of this many chunks or more temporarily
# disable refresh_interval on the chunks index for the duration of the load.
# Meaningful for 6+ hour transcripts; ignored for typical files.
# SEARCH_LARGE_TRANSCRIPT_CHUNKS=500
# Number of parallel workers for a full reindex (default: 4)
# REINDEX_PARALLEL_WORKERS=4

# Transcript chunking (words per chunk / overlap between consecutive chunks).
# Changing these only affects chunks created AFTER the change — existing chunks
# keep the size they were created with; a changed default does not retroactively
# reshape the index (a full reindex is required to apply it everywhere).
# SEARCH_CHUNK_TARGET_WORDS=200
# SEARCH_CHUNK_OVERLAP_WORDS=40

# Result-set tuning. SEARCH_MAX_OVERFETCH bounds how many collapsed file groups are
# over-fetched for client-side sorting (default: 1000). The three *_SCORE /
# *_CONFIDENCE values are semantic-search cutoffs used to filter and rank
# lower-confidence hits (defaults: 0.005, 0.010, 0.20 — the last is a fraction of
# the semantic score range, 0.5 = keep top half).
# SEARCH_MAX_OVERFETCH=1000
# SEARCH_HYBRID_MIN_SCORE=0.005
# SEARCH_SEMANTIC_HIGH_CONFIDENCE=0.010
# SEARCH_SEMANTIC_SUPPRESS_RATIO=0.20

# Hybrid fusion strategy (issue #363). Env-only, deliberately NOT DB-backed — these
# are measurement knobs for the BM25/neural fusion A/B, not admin settings. "rrf"
# (Reciprocal Rank Fusion, the shipped default) or "normalization" (OpenSearch's
# normalization-processor). The RRF/normalization-specific knobs below apply only
# to their respective strategy.
# SEARCH_FUSION_STRATEGY=rrf
# SEARCH_RRF_RANK_CONSTANT=30
# SEARCH_RRF_WINDOW_SIZE=500
# SEARCH_NORMALIZATION_TECHNIQUE=min_max
# SEARCH_COMBINATION_TECHNIQUE=arithmetic_mean
# Comma-separated per-leg weights, e.g. "0.7,0.3" (BM25, neural). Empty = equal.
# SEARCH_COMBINATION_WEIGHTS=

# SQLAlchemy connection pool for the FastAPI backend (Celery workers fork
# separate engines and are unaffected). Raise under heavy concurrent uploads.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=40

# Server-side backstop against a transaction left open while the process does
# slow non-database work (an HTTP call, model inference, file I/O), which holds
# ACCESS SHARE locks and pins the VACUUM horizon. Postgres terminates a backend
# that has an OPEN transaction and is running NO query for this long.
#
# It CANNOT interrupt a slow query — only an idle one — so legitimate
# long-running statements are never affected. Migrations are outside it too:
# app/db/migrations.py builds its own engines.
#
# Default 300000 (5 minutes). Set to 0 to disable.
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000

#=============================================================================
# SECURITY & AUTHENTICATION
#=============================================================================

# Deployment environment. FAIL-CLOSED: anything other than the relaxed names
# below (development, dev, testing, test, local) is treated as production, and
# an UNSET value means production. Production enforces: refusal to boot on
# default JWT_SECRET_KEY / ENCRYPTION_KEY, DEBUG off, REDIS_PASSWORD required,
# Secure cookies, and no well-known admin seed.
#
# Leave this unset (or set it to production) for a real deployment. The dev
# stack sets ENVIRONMENT=development itself via docker-compose.override.yml,
# so you do NOT need to set it here to run `./opentr.sh start dev`.
# ENVIRONMENT=production

# Whether the backend runs Alembic migrations on startup.
#
# true (default): self-hosting — the stack migrates itself on upgrade.
# false: Kubernetes/ECS, where a dedicated migrate Job owns migrations (otherwise
#   replicas race Alembic). When false, /health/ready returns 503 until the schema
#   is at head, so an un-migrated replica never takes traffic.
# RUN_MIGRATIONS_ON_STARTUP=true

# Container image tag every service pulls. The installer pins this to the release
# it installed, which is what makes an install reproducible and a rollback
# possible (`./opentranscribe.sh update --version vX.Y.Z`). Left at `latest` you
# track whatever was published most recently.
# OT_IMAGE_TAG=latest

# Global server-side maximum upload size, in bytes. Enforced at /files/prepare
# (declared size) AND /files/complete (the size MinIO actually observed, which is
# authoritative since bytes go browser->MinIO directly). Matches the 15 GB the UI
# advertises. Set 0 to disable — only sensible on a trusted single-user install.
# MAX_UPLOAD_BYTES=16106127360

# Whether anyone can create their own account via POST /api/auth/register.
# New users are immediately active and GPU-capable, so on a public deployment
# this is the door in front of every per-user cost. Set false when an external
# IdP owns identity, or when accounts should be admin-provisioned.
#
# This is the ENV FALLBACK. The live value is DB-backed and editable with no
# restart at Settings -> Authentication -> Local ("Allow self-registration"),
# which takes precedence once saved.
# ALLOW_OPEN_REGISTRATION=true

# Whether a NEWLY PROVISIONED account must be approved by an administrator before
# it can use anything. Applies to self-registration AND to every just-in-time
# account an external IdP creates (LDAP / OIDC). Approve or reject from
# Settings -> Users -> Pending approval; a rejected account is kept, not deleted.
#
# Default false, so an upgrade changes nothing: with it off, accounts are created
# 'approved' exactly as before. The bootstrap super_admin is never held.
#
# This is the ENV FALLBACK. The live value is DB-backed and editable with no
# restart at Settings -> Authentication -> Local ("Require admin approval").
# REQUIRE_ACCOUNT_APPROVAL=false

# Whether accounts holding a local password may sign in at all.
# Set false when LDAP / OIDC / PKI is the authoritative identity source and nobody
# should be able to authenticate against a password stored here.
#
# ⚠️ Does NOT hide the login form (LDAP uses the same one), and an ACTIVE
#    super_admin is always exempt — the break-glass account, so a broken IdP
#    cannot lock you out of the screen needed to fix it.
# Also DB-backed (Settings -> Authentication -> Local), which takes precedence.
# LOCAL_AUTH_ENABLED=true

# Publish the interactive API docs (/api/docs, /api/redoc, /api/openapi.json).
# They are served unconditionally in a relaxed environment and withheld in a
# hardened one, because they enumerate the entire admin and auth surface —
# auth-config field names, GDPR erasure routes, session termination — to any
# anonymous visitor. Set true to opt a hardened deployment back in.
# ENABLE_API_DOCS=false

# SSRF egress policy for user-supplied endpoint URLs.
# Every server-side fetch of a user-supplied URL (LLM/ASR "test connection" and
# model discovery, watch-source S3 endpoints and SMB servers, yt-dlp ingest) is
# refused if it resolves to a private, loopback, link-local, or cloud-metadata
# address.
#
# LLM_ALLOW_PRIVATE_ENDPOINTS re-enables private targets for self-hosted
# Ollama/vLLM on a LAN. Leave it FALSE on any multi-tenant or publicly
# registerable deployment — with it on, any user can point a "test connection"
# at internal services and cloud instance metadata.
# LLM_ALLOW_PRIVATE_ENDPOINTS=false
#
# WATCH_ALLOW_PRIVATE_ENDPOINTS is the same switch for watch sources. It
# defaults to TRUE because a LAN NAS is the normal single-tenant case; set it to
# false on a multi-tenant deployment.
# WATCH_ALLOW_PRIVATE_ENDPOINTS=true

# Bootstrap admin account.
# In a relaxed (development) environment the seeder always creates the
# well-known admin@example.com / "password" super_admin that the test suite
# expects, and these two variables are ignored.
# In production that credential is NEVER created. Set a password here, or leave
# it unset and the seeder generates a strong random one and logs it ONCE at
# startup (search the backend log for "GENERATED password").
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=

# JWT Token Configuration
# CRITICAL: Used for user session authentication
# Auto-generated during install (64-char random hex for maximum security)
JWT_SECRET_KEY=CHANGE_ME_auto_generated_on_install
JWT_ALGORITHM=HS256
# ─── UI-managed: set these in Settings -> Authentication ──────────────────────
# Password policy, MFA, session timeouts, lockout, rate limits and the login
# banner are stored in the DATABASE and edited in the admin UI. 28 env vars for
# them were removed from this template: the UI is the supported way to set them,
# and two copies of one setting is how they drift apart.
# Precedence is database > env > built-in default, so a UI value always wins.
# For a zero-touch provisioned deployment you may still set them by env using the
# SCREAMING_SNAKE form of the UI field name (see backend/app/schemas/auth_config.py).


# Session Timeout Settings (NIST SP 800-63B compliant)
# Idle timeout: Session expires after this many minutes of inactivity
# Absolute timeout: Session expires after this many minutes regardless of activity

# Rate Limiting (OWASP recommended)
# Requests per minute allowed on authentication endpoints
# Dev-stack-only relaxations (docker-compose.override.yml — never loaded in
# prod) so the e2e suite's hundreds of real logins aren't throttled or
# lockout-poisoned. Deployed stacks keep the strict values above.
#DEV_RATE_LIMIT_AUTH_PER_MINUTE=120
#DEV_ACCOUNT_LOCKOUT_THRESHOLD=100
#DEV_ACCOUNT_LOCKOUT_DURATION_MINUTES=1
# Requests per minute allowed on general API endpoints
RATE_LIMIT_API_PER_MINUTE=100
# Enable/disable rate limiting (set to 'false' to disable)
# Trusted proxy IPs for X-Forwarded-For header (comma-separated IPs or CIDR ranges)
# Only trust X-Forwarded-For from these IPs. Empty = trust direct connection only.
# LEAVE EMPTY unless you add your own proxy — the nginx/pki/prod overlays already
# default to Docker's pool (127.0.0.1/32,172.16.0.0/12). A value here OVERRIDES
# that, so re-include the Docker range if you add to it.
# ⚠️ Never add a LAN range (10./192.168.) you can reach the backend from: any host
#    on it could then forge X-Forwarded-For and pick its own audit identity.
RATE_LIMIT_TRUSTED_PROXIES=

# Account Lockout Settings (NIST AC-7 compliant)
# Enable/disable account lockout after failed login attempts
# Number of failed attempts before account is locked
# Base lockout duration in minutes
# Enable progressive lockout (increases duration with each lockout)
# 1st: 15min, 2nd: 30min, 3rd: 60min, 4th+: max duration
# Maximum lockout duration in minutes (24 hours)

# API Key Encryption
# CRITICAL: Used to encrypt LLM API keys stored in database
# Auto-generated during install (random string with prefix to ensure proper backend processing)
# NEVER change this after first use or encrypted data will be lost!
# To manually generate: echo "opentranscribe_$(openssl rand -base64 48)"
ENCRYPTION_KEY=CHANGE_ME_auto_generated_on_install

# Public base URL of this deployment. EVERY credential link the app mails
# (password reset, invitation, email verification) is built from it.
#
# ⚠️ REQUIRED IN PRODUCTION, AND SET IN NO COMPOSE FILE. Leaving it at the
# localhost default means every user is mailed a link to their own machine, and
# those links are single-use — a useless one burns the recipient's attempt and
# their 3-resets-per-hour budget. The backend therefore REFUSES to send a
# credential link that still points at http://localhost:5173 once a real mail
# transport is configured, and logs the refusal at CRITICAL. Dev is unaffected
# (no transport is configured there, so no mail is attempted at all).
FRONTEND_URL=http://localhost:5173

#-----------------------------------------------------------------------------
# Transactional auth email (password reset / invitation / verification /
# security notice)
#-----------------------------------------------------------------------------
# PREFERRED: set this up in the Admin UI (Settings -> Watch Sources -> Email
# Configurations). Credentials are encrypted at rest, there is a test-send
# button, and no restart is needed. A UI config WINS over the vars below.
# These SMTP_* vars are only the fallback when no config is designated.
# SMTP_HOST empty = no mail at all; password-reset sends then fail loudly.
SMTP_HOST=
# 587 = submission with STARTTLS (honours SMTP_USE_TLS).
# 465 = implicit SSL; TLS is negotiated before the greeting and SMTP_USE_TLS
#       does not apply. Any other port behaves like 587.
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

# Abuse / DMCA / safe-harbor intake address surfaced in the UI/API for abuse
# reports and copyright takedown notices. Empty = not configured. The takedown
# enforcement (admin quarantine on a file) ships in the product regardless; this
# is just the published contact. See docs/abuse-and-takedown.md.
ABUSE_CONTACT_EMAIL=

#=============================================================================
# APPLICATION PORTS (External Access)
#=============================================================================

# External port configuration (accessible from host machine)
# Consistent ports across all environments to avoid confusion
FRONTEND_PORT=5173          # Web UI
BACKEND_PORT=5174           # API Server
FLOWER_PORT=5175            # Celery Task Monitor
POSTGRES_PORT=5176          # Database (for admin tools)
REDIS_PORT=5177             # Redis (for debugging)
MINIO_PORT=5178             # MinIO API
MINIO_CONSOLE_PORT=5179     # MinIO Web Console
OPENSEARCH_PORT=5180        # OpenSearch API
DOCS_PORT=5183              # Embedded documentation site (proxied at /docs/ in-app)
OPENSEARCH_ADMIN_PORT=5181  # OpenSearch Admin

# Flower Dashboard Authentication (protects the monitoring UI)
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_auto_generated_on_install
# URL prefix Flower serves under (server-side; must match nginx proxy_pass path)
FLOWER_URL_PREFIX=flower

#=============================================================================
# AI MODEL STORAGE & CACHING
#=============================================================================

# Model Cache Directory (on host machine)
# This directory persists AI models between container restarts (~2-6GB total)
MODEL_CACHE_DIR=./models

#=============================================================================
# WATCH SOURCES — auto-import (issue #26)
#=============================================================================
# The ONLY watch-source env var is the mount path — connections, credentials and
# schedules are all DB-backed and managed in the admin UI.
# Mounted to /watch by ./opentr.sh start dev --with-watch. Without that overlay
# this is unused and the "local" source type is hidden (S3/SMB still work).
WATCH_HOST_PATH=./watch

# Container-side temp dir for downloaded/stitched watch-source files (S3/SMB
# staging, multipart stitch). Falls back to TEMP_DIR when unset — leave unset
# unless you need watch-source scratch space on a different volume.
# WATCH_TEMP_DIR=

# Host port for the Samba test share (./opentr.sh start dev --with-smb-test).
# Bound to 127.0.0.1 only; containers reach the share at smb-test:445.
SMB_TEST_PORT=4450

# The ONLY scheduled-backup env var is the physical mount path. Everything else
# (enable, cron schedule, retention, encryption) is DB-backed and managed live
# from the admin UI (Settings → System Management → Backups) — no restart, no env.
#
# Host directory where database backups land; mounted to /backups in the
# backend + cpu-worker containers by the docker-compose.backup.yml overlay
# (add `-f docker-compose.backup.yml` to your compose set). Without the overlay
# the feature degrades gracefully: the UI shows the destination as unmounted.
BACKUP_HOST_PATH=./backups
# Host file whose CONTENTS are the gpg passphrase for encrypted backups;
# mounted read-only by the backup overlay. Only needed when backup.encrypt
# is enabled in the admin UI.
# BACKUP_PASSPHRASE_HOST_FILE=/path/to/backup-passphrase.txt
# Host directory that receives the incremental MEDIA MIRROR (issue #242) —
# mounted to /media-mirror in the backend + download-worker containers by the
# same docker-compose.backup.yml overlay. Only needed for the mirror's
# "local folder" destination (the S3 destination needs no mount). All other
# mirror settings (enable, cron, throttle, S3 credentials) are DB-backed and
# managed from the admin UI (Settings → Backups → Media Mirror). The mirror
# copies/updates only — it NEVER deletes files in this directory.
BACKUP_MIRROR_HOST_PATH=./media-mirror

#=============================================================================
# HARDWARE DETECTION & GPU CONFIGURATION
#=============================================================================

# GPU Device Selection (for multi-GPU systems)
# Selects which GPU to use (0 = first GPU, 1 = second GPU, etc.)
GPU_DEVICE_ID=0

# Hardware auto-detection overrides. Default "auto" for all four: TORCH_DEVICE picks
# cuda/mps/cpu, COMPUTE_TYPE picks float16/int8/float32, USE_GPU decides whether the
# GPU path is used at all, BATCH_SIZE is derived from VRAM. Only set one of these to
# force a value auto-detection got wrong for your hardware.
# TORCH_DEVICE=auto     # auto | cuda | mps | cpu
# COMPUTE_TYPE=auto     # auto | float16 | float32 | int8
# USE_GPU=auto          # auto | true | false
# BATCH_SIZE=auto       # auto | <integer>

# Celery worker SQLAlchemy pool size, distinct from the backend API's DB_POOL_SIZE /
# DB_MAX_OVERFLOW above (workers fork their own engines and need far fewer
# connections per process). Defaults: 2 / 3.
# WORKER_DB_POOL_SIZE=2
# WORKER_DB_MAX_OVERFLOW=3


# GPU for the native diarization sidecar (docker-compose.diar-native.yml).
# Defaults to GPU_DEVICE_ID, like GPU_CLUSTERING_DEVICE above — set this ONLY to
# put the sidecar on a different card than transcription.
# The sidecar holds ~4.1 GB of warm ONNX-Runtime arena for as long as it runs, so
# an unintended device here parks several GB on the wrong GPU indefinitely.
# DIAR_NATIVE_GPU=1

# Multi-GPU scaling (advanced). Runs N parallel GPU workers on one dedicated card.
# ⚠️ Enabled by the --gpu-scale FLAG, not by GPU_SCALE_ENABLED (that only affects
#    the GPU-stats display). Usage: ./opentr.sh start dev --gpu-scale
GPU_SCALE_ENABLED=false
GPU_SCALE_DEVICE_ID=2
# GPU_SCALE_POOL=threads        # Celery pool type for scaled workers (default: threads)
GPU_SCALE_WORKERS=4
# GPU_SCALE_DEFAULT_WORKER: dual-GPU toggle for --gpu-scale.
#   1 = ALSO keep the default GPU worker running on GPU_DEVICE_ID alongside the
#       scaled workers on GPU_SCALE_DEVICE_ID — i.e. BOTH GPUs do transcription.
#   0 = only the scaled workers run (the default GPU worker is scaled to 0).
# Default 1 (use both GPUs). Set to 0 to dedicate the default GPU to other work.
GPU_SCALE_DEFAULT_WORKER=1

# GPU_SCALE_MAX_TASKS: Worker process restarts after this many tasks (memory safety)
# Default: 500. Set to 0 for never restart (infinite). Lower values reclaim memory
# more often but incur model reload overhead (~10-15s per restart).
# GPU_SCALE_MAX_TASKS=500

# GPU Worker Max Tasks (default single worker)
# Default: 100000 (effectively never restart, keeps models warm).
# Note: Celery does not accept 0; use a high number instead.
#
# IMPORTANT: --max-tasks-per-child is a PREFORK-pool feature. The GPU workers use
# --pool=threads by default (to keep model weights pinned in VRAM), and under threads
# Celery IGNORES this setting entirely — lowering it does NOT give you worker
# recycling or a VRAM-leak guard. The worker logs a warning at startup if you set a
# meaningful value while on the threads pool. If you genuinely need recycling, set
# GPU_WORKER_POOL=prefork and accept that the model reloads on every task.
# GPU_MAX_TASKS=100000

# GPU Default Batch Size (for default single-GPU worker)
# Auto-detected from GPU VRAM: 32 for 40GB+, 24 for 24GB, 12 for 12GB, 8 for 8GB.
# Only set this if you want to override auto-detection (e.g., multi-GPU with different cards).
# GPU_DEFAULT_BATCH_SIZE=auto

# How many transcriptions share the GPU at once. Models are pinned in VRAM once
# at startup, so there is no per-task reload cost.
# "auto" (recommended) = (VRAM - 7 GB) / 4 GB, capped at 12.
#   12 GB -> 1    24 GB -> 4    49 GB -> 10    80 GB -> 12
# Match GPU_SCALE_WORKERS to this when using --gpu-scale.
GPU_CONCURRENT_REQUESTS=1

# FFMPEG_THREADS: per-process ffmpeg thread cap for the CPU preprocess (audio
# extraction/resampling). Default 0 = ffmpeg auto/unbounded (no change).
# The CPU worker runs up to CPU_WORKER_CONCURRENCY preprocess tasks at once; on
# low-core machines or when OpenTranscribe shares a host with other services,
# unbounded ffmpeg can oversubscribe cores. Options:
#   0      → unbounded (default; best on high-core GPU servers — benchmarked: no
#            throughput/CPU benefit from capping there, GPU is the bottleneck)
#   auto   → cores // CPU_WORKER_CONCURRENCY (no oversubscription; for laptops)
#   <int>  → explicit cap, e.g. 2-4 on a 4-8 core laptop
FFMPEG_THREADS=0

# GPU_WORKER_POOL: Celery pool type for GPU worker.
# Default: "threads" — model stays loaded in the process between tasks,
# keeping weights pinned in GPU VRAM. Even at concurrency=1, threads pool
# avoids the fork-per-task overhead of prefork and keeps the model warm.
# Set to "prefork" only if you need full process isolation per task (legacy).
# GPU_WORKER_POOL=threads

# Migration GPU settings are AUTO-DETECTED from available VRAM.
# (MIGRATION_GPU_WORKERS / MIGRATION_MAX_CONCURRENT_TASKS were documented here as
# manual overrides but were never implemented — nothing in the repo read either
# one, so setting them did nothing. Removed rather than left as advice that
# silently fails.)

# Benchmark & Profiling (enable before running scripts/benchmark_*.py)
# ENABLE_BENCHMARK_TIMING records inter-stage timestamps (dispatch, preprocess, GPU, postprocess)
# to Redis for pipeline gap analysis. ENABLE_VRAM_PROFILING captures per-step GPU VRAM
# snapshots (NVML + PyTorch) and saves them to Redis for the admin GPU profiles endpoint.
# Both are lightweight and safe for production, but add Redis writes per task.
# ENABLE_BENCHMARK_TIMING=false
# ENABLE_VRAM_PROFILING=false

# ─── Engine (Phase 1b split-stage Celery optimization) ───────────────────────
# The two BACKEND settings below are admin-editable at Settings -> Engine
# Configuration; the values here are only the fallback used before anything is
# saved there. ENGINE_GPU_SPLIT and ENGINE_SHARED_VOLUME_PATH further down ARE
# env-only — they need matching container topology.
ENGINE_TRANSCRIBER_BACKEND=faster_whisper  # faster_whisper | whisperx | cloud
# native (default — the Rust diar-native sidecar, docker-compose.diar-native.yml, with
# automatic in-process pyannote fallback when the sidecar is unreachable) | pyannote
# ⚠️ Leaving this set to pyannote overrides the native default — delete or set native.
ENGINE_DIARIZER_BACKEND=native
# Split transcribe/diarize onto separate GPUs. ONLY works when you also start the dedicated
# split workers (see "Multi-GPU split" below): docker compose --profile gpu-split up -d.
# Enabling this without those workers routes tasks to empty queues and they will hang.
ENGINE_GPU_SPLIT=false
ENGINE_SHARED_VOLUME_PATH=/tmp/transcription  # internal cross-stage WAV handoff dir (split path)
# (ENGINE_PRECOMPUTE_VAD intentionally omitted — Phase-3a CPU-VAD precompute is not implemented.)

# Diarization boundary correction (issue #193) is configured in the admin UI
# (Settings → Engine Configuration), saved to the DB, no restart needed — so it is NOT
# listed here. Code defaults: boundary smoothing ON (collapses 1-3 word wrong-speaker
# islands; -32% WSER, AMI-regression-safe); acoustic backchannel re-check OFF (experimental;
# reassigns short absorbed "yeah"/"mm-hmm" by voiceprint, +~15% on top of the smoother).
# Advanced knobs (island size, silent gap, cosine margin, …) are DB-overridable under the
# engine.boundary_* keys if you ever need to tune them; otherwise the defaults apply.

# Multi-GPU pipeline SPLIT — run transcription and diarization on SEPARATE GPUs.
# Only used when ENGINE_GPU_SPLIT=true. Start the split workers with:
#   ./opentr.sh start dev --with-gpu-split
# (loads docker-compose.gpu-split.yml, which reserves one host GPU per worker).
# These MUST be different GPU indices for the split to help; if equal, both
# stages share one card (no benefit). Docker remaps each reserved card to
# index 0 inside its container, so the workers always run on CUDA device 0.
GPU_TRANSCRIBE_DEVICE_ID=0  # host CUDA device for gpu-transcribe worker (WhisperX)
GPU_DIARIZE_DEVICE_ID=1     # host CUDA device for gpu-diarize worker (PyAnnote)

#=============================================================================
# AI MODELS CONFIGURATION
#=============================================================================

# =============================================================================
# WHISPER MODEL CONFIGURATION
# =============================================================================
#   model                      VRAM   use when
#   large-v3-turbo (DEFAULT)   ~6 GB  most cases. CANNOT translate to English.
#   large-v3                  ~10 GB  non-English, or "Translate to English"
#   large-v2                  ~10 GB  fallback if v3 misbehaves
#   tiny|base|small|medium      less  low-VRAM or CPU-only
#   nyrahealth/CrisperWhisper ~10 GB  precise word timings. ENGLISH ONLY.
WHISPER_MODEL=large-v3-turbo

# Lightweight model for fast CPU transcription (default: base)
# Used when users select "Fast Processing" — runs on CPU, no GPU impact
# WHISPER_LIGHTWEIGHT_MODEL=base

# Hybrid mode: CPU transcription + GPU/MPS diarization
# Auto-activates when GPU VRAM is too small for the configured WHISPER_MODEL,
# or always on macOS (MPS diarization works; MPS transcription is unreliable).
# Values: auto (default), true, false
# WHISPER_HYBRID_MODE=auto
#
# Model used for transcription when hybrid mode is active (default: small).
# small gives good accuracy at ~15-30x real-time on modern CPU/Apple Silicon.
# WHISPER_HYBRID_CPU_MODEL=small

# Enable speaker diarization (true/false). Default: true.
# PyAnnote diarization requires CUDA — set to false on CPU-only deployments
# (the installer auto-sets this to false when DETECTED_DEVICE=cpu). Leaving
# it enabled on CPU will either crash the worker or run unusably slowly.
ENABLE_DIARIZATION=true

# Speaker Diarization Model
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
MIN_SPEAKERS=1
MAX_SPEAKERS=20  # Can be increased to 50+ for large conferences (no hard limit)

# Force an EXACT speaker count for every transcription (overrides MIN_SPEAKERS /
# MAX_SPEAKERS system-wide). Leave unset (auto-detect) unless every recording you
# process has the same, known number of speakers.
# NUM_SPEAKERS=

# Diarization batch sizes
# - Segmentation: auto-detected from GPU VRAM (DIARIZATION_BATCH_SIZE overrides).
# - Embedding: PINNED AT 16 in code per Phase A measurements (throughput
#   saturates; larger batches waste 3-7 GB of VRAM for <3 % speed gain).
#   The DIARIZATION_EMBEDDING_BATCH_SIZE env var is still honored for
#   research/debugging but not required and not recommended for production.
# See docs/diarization-vram-profile/README.md for the raw benchmark data.
# DIARIZATION_BATCH_SIZE=32             # segmentation batch (low VRAM -> reduce)
# DIARIZATION_EMBEDDING_BATCH_SIZE=16   # research-only override; leave unset

# HuggingFace Token (REQUIRED for speaker diarization)
# Get your token at: https://huggingface.co/settings/tokens
# You must accept PyAnnote model terms at: https://huggingface.co/pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# =============================================================================
# TRANSCRIPTION PERFORMANCE OPTIONS
# =============================================================================
# These options can significantly reduce processing time at the cost of some features

# Whisper beam_size: lower = faster but slightly less accurate
# Default: 5 (WhisperX default). Set to 1 for greedy decoding (~25-40% faster transcription)
# Trade-off: beam_size=1 is ~1-2% lower WER for English
# WHISPER_BEAM_SIZE=5

# Whisper compute_type: quantization for faster inference
# Default: auto-detected (float16 on CUDA). Options: float16, int8_float16, int8, float32
# int8_float16 gives ~15-25% speedup with negligible quality loss (-0.1 WER)
# Requires CUDA compute capability >= 7.0
# WHISPER_COMPUTE_TYPE=float16

# VRAM profiling: captures per-step GPU memory usage and timing data
# Enable temporarily to diagnose VRAM bottlenecks or benchmark pipeline changes
# Reports are logged at INFO level when enabled
ENABLE_VRAM_PROFILING=false

# Voice Activity Detection (VAD) tuning — read at pipeline dispatch as the
# system-wide default (backend/app/transcription/config.py). Defaults match
# core/constants.py's DEFAULT_VAD_*. Lower thresholds/pad values catch more speech
# at the cost of more false positives on quiet audio.
# VAD_THRESHOLD=0.5          # speech-detection sensitivity (0.1-0.95)
# VAD_MIN_SILENCE_MS=2000    # min silence to split segments (ms)
# VAD_MIN_SPEECH_MS=250      # min speech duration to keep (ms)
# VAD_SPEECH_PAD_MS=400      # padding around detected speech (ms)

#=============================================================================
# LLM PROVIDER CONFIGURATION (Optional - for AI Summarization)
#=============================================================================

# LLM Provider Selection
# IMPORTANT: Users configure LLM providers through the Web UI (Settings → LLM Provider)
# This is a system-wide default fallback when no user settings exist
#
# Options: vllm, openai, ollama, anthropic, bedrock, openrouter, custom, or leave empty
# Leave empty for transcription-only mode (no AI summarization/speaker identification)
LLM_PROVIDER=

# Allow LLM endpoints on private/internal addresses (SSRF protection).
# Default false: the backend refuses to call private IPs, which blocks a whole
# class of server-side request forgery. Set to true ONLY when you intentionally
# run a self-hosted model the backend must reach on a private network — Ollama,
# vLLM, or a model server on your LAN or the Docker network. Without it those
# providers fail with "Health check blocked ... Private IP address".
LLM_ALLOW_PRIVATE_ENDPOINTS=false

# LLM Context Window Configuration
# Users configure max_tokens (context window) via Web UI: Settings → LLM Provider → Max Tokens
# Set to your model's actual capability for best performance:
#   - GPT-4 Turbo: 128000
#   - Claude 3 Opus/Sonnet/Haiku: 200000
#   - Mistral 7B: 8192
#   - Custom vLLM models: Check model card (e.g., gpt-oss-20b: 130000)
# Default: 8192 (conservative fallback)
# Range: 512 - 2,000,000

# ─────────────────────────────────────────────────────────────────────────
# vLLM (Self-Hosted Open Source LLM Server)
# ─────────────────────────────────────────────────────────────────────────
# ⚠️ Local server? You MUST also set LLM_ALLOW_PRIVATE_ENDPOINTS=true above,
#    or calls to localhost/private IPs are blocked and you get an opaque
#    "Private IP address" error.
VLLM_BASE_URL=http://localhost:8012/v1
VLLM_MODEL_NAME=
VLLM_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# OpenAI (Commercial Cloud API)
# ─────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────────────────
# Ollama (Self-Hosted Local LLM)
# ─────────────────────────────────────────────────────────────────────────
# ⚠️ Local server? You MUST also set LLM_ALLOW_PRIVATE_ENDPOINTS=true above,
#    or calls to localhost/private IPs are blocked and you get an opaque
#    "Private IP address" error.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1:8b

# ─────────────────────────────────────────────────────────────────────────
# Anthropic Claude (Commercial Cloud API)
# ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ─────────────────────────────────────────────────────────────────────────
# OpenRouter (Multi-Provider API Gateway)
# ─────────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─────────────────────────────────────────────────────────────────────────
# Amazon Bedrock (AWS-native — no API key)
# ─────────────────────────────────────────────────────────────────────────
# Claude/Nova/Llama/Mistral via one API. No API key: boto3 uses the standard AWS
# chain (instance role, task role, profile, env), so EC2/ECS/EKS needs no secret.
# IAM: bedrock:InvokeModelWithResponseStream + bedrock:InvokeModel.
# Region falls back to AWS_REGION / AWS_DEFAULT_REGION when empty.
BEDROCK_REGION=
# The model is chosen per user in the UI (Settings -> AI Provider); there is no
# deployment-wide default for it. Only BEDROCK_REGION is read from the env.

#=============================================================================
# ASR (SPEECH RECOGNITION) PROVIDER
#=============================================================================
# Provider: local (default, requires GPU), deepgram, assemblyai, openai,
#           google, azure, aws, speechmatics, gladia
ASR_PROVIDER=local

# --- Deepgram (ASR_PROVIDER=deepgram) ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# --- AssemblyAI (ASR_PROVIDER=assemblyai) ---
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_MODEL=universal

# --- OpenAI Whisper / GPT-4o Transcribe (ASR_PROVIDER=openai) ---
# Uses OPENAI_API_KEY defined above
OPENAI_ASR_MODEL=gpt-4o-transcribe

# --- Google Cloud Speech (ASR_PROVIDER=google) ---
# Provide path to service account JSON file
GOOGLE_CLOUD_CREDENTIALS=
GOOGLE_ASR_MODEL=chirp-3

# --- Azure Speech (ASR_PROVIDER=azure) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_ASR_MODEL=whisper

# --- Amazon Transcribe (ASR_PROVIDER=aws) ---
# Access credentials — leave empty to use an IAM role / instance profile instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region where your Transcribe jobs will run (must match bucket region)
AWS_REGION=us-east-1
AWS_ASR_MODEL=standard
# S3 bucket used by Amazon Transcribe to store intermediate output (must exist)
AWS_TRANSCRIBE_BUCKET=

# --- Speechmatics (ASR_PROVIDER=speechmatics) ---
SPEECHMATICS_API_KEY=
SPEECHMATICS_MODEL=standard

# --- Gladia (ASR_PROVIDER=gladia) ---
GLADIA_API_KEY=
GLADIA_MODEL=standard

# --- Cloud ASR options ---
# Concurrency for the cloud-asr worker is CLOUD_ASR_CONCURRENCY — see the worker
# tuning section below. This entry previously read CLOUD_ASR_WORKER_CONCURRENCY,
# which no compose file or script has ever read, so anyone who set it here got
# the default and no warning.
# Lite backend image (API-Lite mode)
BACKEND_LITE_IMAGE=davidamacey/opentranscribe-backend-lite:latest

#=============================================================================
# CONTENT REDACTION
#=============================================================================
# Deployment-time (non-DB) settings for the redaction worker and its ML models.
# Per-user enable/disable, categories, style, custom words, and allowlist are
# DB-backed (Settings → Content Redaction / admin Redaction Policy), with coded
# defaults in backend/app/core/constants.py — so there are NO required redaction
# .env vars; the settings below only tune the redaction worker / model hosting.
REDACTION_DEVICE=auto            # auto | cpu | cuda — compute device for redaction ML models
REDACTION_GPU_DEVICE_ID=         # spare GPU id for redaction models when REDACTION_DEVICE=cuda
REDACTION_MIN_FREE_VRAM_GB=1.5   # free-VRAM floor before redaction worker uses GPU
REDACTION_CONCURRENCY=2          # redaction worker concurrency
REDACTION_TORCH_THREADS=8        # caps OMP/MKL threads for the redaction worker
REDACTION_NICE=10                # OS nice priority for the redaction worker
REDACTION_PII_USE_GLINER=false   # use GLiNER for PII NER (slower, more accurate) vs spaCy NER
# DOWNLOAD_REDACTION_MODELS=true # pre-download redaction model weights at image build (offline)
# PRELOAD_REDACTION_MODELS=true  # load PII/toxicity models — set only on the redaction worker

#=============================================================================
# DEPLOYMENT MODE
#=============================================================================
# full: Local GPU + optional cloud ASR (default)
# lite: Cloud-only ASR, no GPU required (~2 GB image)
DEPLOYMENT_MODE=full

#=============================================================================
# YOUTUBE ANTI-BOT DETECTION & RATE LIMITING
#=============================================================================
# Prevents YouTube from flagging your IP as a bot with progressive delays,
# cookie authentication, and per-user rate limits.

# Cookie-Based Authentication (allows yt-dlp to use browser cookies)
# ─────────────────────────────────────────────────────────────────────────
# Enables downloading sign-in required, age-restricted, or members-only videos
# Requires browser to be installed IN the Docker container
# Supported browsers: firefox, chrome, chromium, edge, safari, opera
# Leave empty to disable cookie authentication
YOUTUBE_COOKIE_BROWSER=

# Alternative: Explicit cookie file path (for headless servers)
# Use this if you export cookies.txt manually from your desktop browser
# Leave empty to use browser extraction instead
YOUTUBE_COOKIE_FILE=

# Playlist Staggering (progressive delays when dispatching playlist videos)
# ─────────────────────────────────────────────────────────────────────────
# Prevents all playlist videos from downloading simultaneously
YOUTUBE_PLAYLIST_STAGGER_ENABLED=true
YOUTUBE_PLAYLIST_STAGGER_MIN_SECONDS=5    # Minimum delay between videos
YOUTUBE_PLAYLIST_STAGGER_MAX_SECONDS=30   # Maximum delay (caps at this value)
YOUTUBE_PLAYLIST_STAGGER_INCREMENT=5      # Delay increases by this amount per video

# Pre-Download Jitter (random delay before each download starts)
# ─────────────────────────────────────────────────────────────────────────
# Adds unpredictable timing to make traffic look more human
YOUTUBE_PRE_DOWNLOAD_JITTER_ENABLED=true
YOUTUBE_PRE_DOWNLOAD_JITTER_MIN_SECONDS=2   # Minimum random delay
YOUTUBE_PRE_DOWNLOAD_JITTER_MAX_SECONDS=15  # Maximum random delay

# User Rate Limiting (per-user quotas to prevent abuse)
# ─────────────────────────────────────────────────────────────────────────
# Limits downloads per user with hourly/daily quotas tracked in Redis
YOUTUBE_USER_RATE_LIMIT_ENABLED=true
YOUTUBE_USER_RATE_LIMIT_PER_HOUR=50   # Maximum downloads per user per hour
YOUTUBE_USER_RATE_LIMIT_PER_DAY=500   # Maximum downloads per user per day

# Recovery throttle: max YouTube downloads re-queued per health-check cycle
# (every 10 min). With default of 3, max recovery rate is 18/hour.
# Keep well below YOUTUBE_USER_RATE_LIMIT_PER_HOUR to leave room for
# user-initiated downloads. Transcription retries are NOT throttled by this.
YOUTUBE_RECOVERY_BATCH_SIZE=3

# Master switch for automatic YouTube download retries.
# Set to false to stop ALL automatic retry loops (both Celery task retries and
# the periodic recovery re-queuing).  Manual downloads via the UI still work.
# Re-enable by setting to true and restarting the celery-worker container.
YOUTUBE_AUTO_RETRY_ENABLED=true

# Celery task-level rate limit for YouTube downloads.
# Enforced by the download worker regardless of queue depth — tasks queue
# freely but only N execute per time window.  Works in concert with the
# recovery batch size above and the per-user rate limits.
# Format: "N/h" (per hour), "N/m" (per minute), "N/s" (per second).
# Set to empty string to disable.
YOUTUBE_DOWNLOAD_RATE_LIMIT=30/h

#=============================================================================
# FRONTEND CONFIGURATION
#=============================================================================

# API Connection URLs (used by frontend to connect to backend)
VITE_API_BASE_URL=http://localhost:5174/api
# (VITE_WS_BASE_URL was listed here but is not read by anything: the WebSocket URL
# is derived from VITE_API_BASE_URL / window.location.origin in
# frontend/src/lib/utils/url.ts. Setting it had no effect.)

# Dev-only: Vite dev-server proxy target for MinIO, for remote dev setups (e.g. a
# Mac editor pointed at a Linux GPU server). Read by frontend/vite.config.ts;
# has no effect on the production/nginx build. Leave unset for the normal
# same-host `./opentr.sh start dev` workflow.
# VITE_MINIO_URL=http://your-remote-host:5178

# Flower (Celery Task Monitor) URL prefix for frontend links
# Both dev (Vite proxy) and prod (Nginx proxy) inject auth headers server-side
VITE_FLOWER_URL_PREFIX=flower

# Optional frontend error reporting (Sentry) — OFF by default.
# Leave VITE_SENTRY_DSN empty to keep error monitoring fully disabled (zero bundle
# impact; the SDK is lazy-loaded only when a DSN is set). To enable, install the SDK
# in frontend/ (`npm i @sentry/svelte`), set a DSN, then rebuild the frontend image.
# See frontend/src/lib/monitoring.ts and docs/deployment/AWS_PRODUCTION.md.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_TRACES_SAMPLE_RATE=0

#=============================================================================
# ADVANCED CONFIGURATION (Internal Docker Settings)
#=============================================================================
# The following variables are used internally by Docker containers
# and typically don't need to be changed unless you're doing advanced customization

# Internal service hostnames (Docker Compose service names)
# These are DNS names within the Docker network
# POSTGRES_HOST=postgres (already set above)
# MINIO_HOST=minio (already set above)
# REDIS_HOST=redis (already set above)
# OPENSEARCH_HOST=opensearch (already set above)

# Celery Configuration (auto-configured from REDIS settings)
# CELERY_BROKER_URL is automatically constructed from REDIS_HOST, REDIS_PORT, REDIS_PASSWORD
# CELERY_RESULT_BACKEND is automatically constructed from REDIS_HOST, REDIS_PORT, REDIS_PASSWORD

# Celery Worker Concurrency Tuning (Optional)
# Adjust these for bulk processing workloads to balance throughput vs resource usage
#
# Download worker: parallel video/URL downloads
# DOWNLOAD_CONCURRENCY=5       # Number of concurrent downloads (default: 5, raise further for bulk imports)
# DOWNLOAD_MAX_TASKS=10        # Restart worker process after N tasks (default: 10)
#
# CPU worker: preprocessing, postprocessing, waveforms
# CPU_WORKER_CONCURRENCY=8     # Concurrent CPU pipeline tasks (default: 8)
#
# Cloud-ASR worker: provider-API transcription jobs
# CLOUD_ASR_CONCURRENCY=4      # Concurrent cloud transcriptions (default: 16)
#
# Redaction worker process recycling / pool
# REDACTION_MAX_TASKS=200      # Restart redaction worker after N tasks (compose default: 200)
# REDACTION_WORKER_POOL=threads
#
# NLP worker: LLM-powered summarization, speaker ID, topic extraction
# NLP_CONCURRENCY=4            # Number of concurrent NLP tasks (default: 4)
# NLP_MAX_TASKS=50             # Restart worker process after N tasks (default: 50)

# PostgreSQL Performance Tuning (Optional)
# These override the PostgreSQL defaults in docker-compose.yml.
# Defaults are tuned for a 4-8GB RAM server with SSD storage.
# Adjust based on your available RAM and storage type.
#
# PG_SHARED_BUFFERS=256MB          # 25% of available RAM (default: 256MB)
# PG_EFFECTIVE_CACHE_SIZE=1GB      # ~75% of available RAM for OS cache estimate (default: 1GB)
# PG_WORK_MEM=16MB                 # Per-sort/hash operation memory (default: 16MB)
# PG_MAINTENANCE_WORK_MEM=128MB    # For VACUUM, CREATE INDEX (default: 128MB)
# PG_RANDOM_PAGE_COST=1.1          # SSD=1.1, HDD=4.0 (default: 1.1 for SSD)
# PG_EFFECTIVE_IO_CONCURRENCY=200  # SSD=200, HDD=2 (default: 200 for SSD)
# PG_MAX_CONNECTIONS=200           # Max client connections (default: 200)

# Database URL (auto-constructed from POSTGRES_* variables)
# DATABASE_URL is automatically built by the backend from individual POSTGRES_* settings

#=============================================================================
# NGINX REVERSE PROXY (Optional - for HTTPS/SSL)
#=============================================================================
# HTTPS is REQUIRED for browser microphone recording and for access from other
# devices. Setup: ./scripts/generate-ssl-cert.sh <name> --auto-ip, set
# NGINX_SERVER_NAME below, then ./opentr.sh start dev (auto-detects the overlay).
# Let's Encrypt and cert trust: docs/NGINX_SETUP.md

# Primary hostname for NGINX (uncomment to enable NGINX)
# Examples: opentranscribe.local, transcribe.home, myserver.example.com
# NGINX_SERVER_NAME=opentranscribe.local

# Optional: Custom ports (defaults: 80 for HTTP redirect, 443 for HTTPS)
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# Optional: Custom certificate paths (defaults to ./nginx/ssl/server.crt and .key)
# NGINX_CERT_FILE=./nginx/ssl/server.crt
# NGINX_CERT_KEY=./nginx/ssl/server.key

#=============================================================================
# OFFLINE/AIR-GAPPED DEPLOYMENT
#=============================================================================
# For offline deployments, the installer will set these automatically

# HuggingFace Hub Offline Mode
# HF_HUB_OFFLINE=1

#=============================================================================
#=============================================================================
# ENTERPRISE AUTHENTICATION — LDAP / OIDC / SAML / PKI / REVERSE-PROXY
#=============================================================================
# CONFIGURE THESE IN THE ADMIN UI, NOT HERE:  Settings -> Authentication
#
# Every LDAP, OIDC and SAML setting, and most PKI/proxy settings, are stored in
# the DATABASE and edited in the admin UI. Secrets are encrypted at rest. The
# resolution order is:
#
#     database  >  this file  >  built-in default
#
# So a value set in the UI WINS over anything written here. Roughly 150 env
# vars used to be documented in this section; they were removed because the UI
# is the supported way to set them and two copies of the same setting is how
# they drift apart.
#
# Set them here ONLY for a zero-touch/provisioned deployment that must come up
# already configured, with no operator visiting the UI. The variable names are
# the SCREAMING_SNAKE form of the field name shown in the UI
# (e.g. "LDAP server" -> LDAP_SERVER); the full list lives in
# backend/app/schemas/auth_config.py.

# --- The exceptions: read BEFORE the database is reachable -------------------
# These four are ALSO read directly at startup by a boot guard that runs before
# any DB session exists (backend/app/main.py). In a hardened deployment the app
# REFUSES TO START if PKI or proxy auth is enabled with an empty trust list —
# an empty list means "reject every header-sourced identity assertion", which
# is the fail-closed behaviour. Deleting these would remove that gate, so they
# stay here even though the DB also covers them.
PKI_ENABLED=false
PKI_TRUSTED_PROXIES=
PROXY_ENABLED=false
PROXY_TRUSTED_PROXIES=

# --- Env-only: no admin-UI equivalent exists ---------------------------------
# In-memory LRU bounds for revocation checking (entries, not bytes).
PKI_OCSP_CACHE_MAX_SIZE=1000
PKI_CRL_CACHE_MAX_SIZE=1000

#=============================================================================
# LOCAL TEST IDENTITY PROVIDERS (development only)
#=============================================================================
# Ports and bootstrap credentials for throwaway IdP containers started with
# ./opentr.sh start dev --with-ldap-test | --with-keycloak-test | --with-authentik-test
# These configure the TEST CONTAINERS, not this application. All bind to
# 127.0.0.1 only. Never reuse these values anywhere real.

# LLDAP  (UI at http://localhost:17170, admin/admin_password)
LDAP_TEST_PORT=3890
LDAP_TEST_UI_PORT=17170

# Keycloak  (http://localhost:8180, admin/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180

# Authentik  (http://localhost:9022, admin@example.com/admin_password)
AUTHENTIK_PORT=9022
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=admin_password
AUTHENTIK_SECRET_KEY=dev-test-secret-key-not-for-production
AUTHENTIK_DB_PASSWORD=authentik-test-only

# PKI/mTLS test rig  (./opentr.sh start prod --build --with-pki)
# PKI_HTTPS_PORT=5182
# PKI_SERVER_NAME=localhost
STEP_CA_PORT=9000

# FEDRAMP COMPLIANCE SETTINGS
#=============================================================================

# FIPS 140-2 Password Hashing
FIPS_MODE=false
PBKDF2_ITERATIONS=210000

# FIPS 140-3 profile (upgraded from 140-2, NIST SP 800-132 2024). FIPS_MODE above
# is the operator's on/off switch; FIPS_VERSION selects the profile once it is on
# — it defaults to "140-3" regardless of FIPS_MODE, so read settings.fips_140_3_active
# (never FIPS_VERSION alone) when gating behavior on it.
# FIPS_VERSION=140-3                    # "140-2" or "140-3"
# PBKDF2_ITERATIONS_V3=600000
# JWT_ALGORITHM_V3=HS512
# ENCRYPTION_ALGORITHM_V3=AES-256-GCM
# FIPS_MIGRATION_MODE=compatible        # "compatible" or "strict"
# FIPS_VALIDATE_ENTROPY=true
# TOTP_ALGORITHM=SHA1                   # SHA1 | SHA256 | SHA512 (SHA1 for app compat)

# Password Policy (FedRAMP IA-5)

# MFA Settings (FedRAMP IA-2) - Disabled by default for air-gapped
# TOTP verification window: time steps of drift accepted before/after (1 = ±30s).
# TOTP_VALID_WINDOW=1
# Require Redis for MFA replay protection (fail-secure). Default follows
# ENVIRONMENT: false in dev/test (so a stack without Redis can still log in),
# true otherwise. With this off, a Redis outage silently makes MFA replayable.
# MFA_REQUIRE_REDIS=true

# Token Management (FedRAMP AC-12)
TOKEN_REVOCATION_ENABLED=true

# Account Management (FedRAMP AC-2)
# NOTE: automatic account expiry after inactivity is NOT implemented. The
# ACCOUNT_INACTIVE_DAYS / ACCOUNT_EXPIRATION_ENABLED vars were removed because
# nothing read them — do not treat AC-2 expiry as satisfied.
# What happens when a login would exceed MAX_CONCURRENT_SESSIONS.
# CONCURRENT_SESSION_POLICY=terminate_oldest  # terminate_oldest | reject

# Login Banner (FedRAMP AC-8)

# Audit Logging (FedRAMP AU-2/AU-3)
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FORMAT=json
AUDIT_LOG_TO_OPENSEARCH=true
AUDIT_LOG_RETENTION_DAYS=365
# Fall back to file-based audit logging when OpenSearch is unavailable (FedRAMP AU-9).
# AUDIT_LOG_FALLBACK_ENABLED=true
# AUDIT_LOG_FALLBACK_PATH=/var/log/opentranscribe/audit-fallback.jsonl

#=============================================================================
# OBSERVABILITY (Metrics, Structured Logs, Monitoring)
#=============================================================================
# Application logging + Prometheus/Grafana. The backend exposes /metrics
# (Prometheus, internal-network only — nginx denies it) and /health/ready.

# Application log format: text (human-readable, default) or json (structured,
# Loki/CloudWatch-ready; access logs carry user_id/org_id/route/db_query_count).
LOG_FORMAT=text
# Slow-query WARNING threshold in milliseconds (logs statement, never params).
SLOW_QUERY_MS=500
# In-process settings cache TTL in seconds (0 disables the cache).
SETTINGS_CACHE_TTL=30
# Master switch for the Redis read-side response cache.
READ_CACHE_ENABLED=true

# Monitoring overlay ports (enabled via: ./opentr.sh start dev --with-monitoring)
PROMETHEUS_PORT=5186
GRAFANA_PORT=5185
GRAFANA_PASSWORD=admin  # CHANGE IN PRODUCTION

#=============================================================================
# PRODUCTION SECURITY HARDENING (Recommended)
#=============================================================================
# A hardening CHECKLIST for deployments handling sensitive data (healthcare PHI,
# financial, government). Every key below is already documented in full earlier in
# this file — these lines are the recommended production VALUES, not new settings.
# Most are also editable at runtime in Settings -> Authentication.
#
# --- Authentication ---
# MFA_ENABLED=true                      # require TOTP
# MFA_REQUIRED=true                     # force enrolment at first login
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30    # default 1440. Needs a restart.
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=1       # default 7
# MAX_CONCURRENT_SESSIONS=3             # 0 = unlimited
#
# --- Account security ---
# ACCOUNT_LOCKOUT_THRESHOLD=3           # default 5
# RATE_LIMIT_AUTH_PER_MINUTE=5          # default 10. Needs a restart.
#
# NOT AVAILABLE: automatic account expiry after inactivity is not implemented.
# Do not treat FedRAMP AC-2 expiry as satisfied by configuration.
#
# --- FIPS (government / healthcare) ---
# FIPS_MODE=true                        # PBKDF2 password hashing
#
# --- Audit ---
# AUDIT_LOG_RETENTION_DAYS=2555         # ~7 years (HIPAA minimum is 6)
# LOGIN_BANNER_ENABLED=true
# LOGIN_BANNER_TEXT="Authorized users only. All activity is monitored and logged."
#
# --- CORS ---
# Restrict to your own domain. This is the only place CORS_ORIGINS is documented.
# CORS_ORIGINS=["https://your-domain.com"]
#
# --- Encryption at rest ---
# MinIO: set MINIO_KMS_SECRET_KEY above.
# PostgreSQL: use encrypted volumes at the host/cloud level (LUKS, EBS, ...).
# Redis: ephemeral session data only; encryption at rest optional.
#
# --- OpenSearch authentication ---
# Set OPENSEARCH_DISABLE_SECURITY=false here in .env (NOT in docker-compose.yml)
# and configure OPENSEARCH_USER / OPENSEARCH_PASSWORD above. Needs additional
# testing — see issue #98.
