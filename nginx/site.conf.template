# OpenTranscribe NGINX Configuration Template
# Environment variables are substituted at container startup via envsubst
#
# Required: NGINX_SERVER_NAME (e.g., transcribe.local, transcribe.example.com)
# Derived by docker-compose.nginx.yml: NGINX_HTTPS_REDIRECT_SUFFIX (empty when the host
# HTTPS port is 443, otherwise ":<port>" so the redirect lands on the published port).

# HTTP server - redirect all traffic to HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${NGINX_SERVER_NAME};

    # Health check endpoint for Docker healthcheck (no redirect)
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Redirect all other HTTP traffic to HTTPS. $host carries no port, so a host HTTPS
    # port other than 443 (NGINX_HTTPS_PORT=8443) has to be appended explicitly or the
    # browser is sent to a port nothing listens on.
    location / {
        return 301 https://$host${NGINX_HTTPS_REDIRECT_SUFFIX}$request_uri;
    }
}

# HTTPS server - main application
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    # SSL/TLS Configuration
    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Hide NGINX version in response headers and error pages
    server_tokens off;

    # Flower is optional (the public demo scales it to 0, docker-compose.demo.yml), so its
    # proxy_pass names a variable and nginx resolves it per request here instead of refusing
    # to start on "host not found in upstream" (nginx.org ngx_http_proxy_module, proxy_pass).
    # 127.0.0.11 is Docker's embedded DNS on user-defined networks (docs.docker.com/engine/network).
    # Every other upstream is a depends_on of this service, so it is up before nginx parses.
    # backend/tests/unit/test_nginx_upstreams_exist_in_every_mode.py enforces this split.
    resolver 127.0.0.11 valid=10s;

    # Security Headers (OWASP recommendations)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "0" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()" always;
    # connect-src 'self' already covers same-host ws:/wss: (CSP3); a bare ws:/wss: source
    # would permit a socket to any host (issue #1028).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self';" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Request-body ceiling. Small by default: only the file-carrying locations below
    # (the API-mediated upload and the object-storage paths) accept a large body.
    # The backend enforces its own, smaller MAX_REQUEST_BODY_BYTES behind this.
    client_max_body_size 10m;
    client_body_timeout 600s;
    client_body_buffer_size 256k;

    # Common proxy settings applied to all locations
    # X-Forwarded-For is OVERWRITTEN with $remote_addr, never appended ($proxy_add_x_forwarded_for):
    # nginx is the edge, so anything already in the header was typed by the client, and the backend
    # trusts this hop's chain (RATE_LIMIT_TRUSTED_PROXIES). Appending let one client pick a new
    # rate-limit bucket per request. A trusted hop in front (Cloudflare, a load balancer) is handled
    # by the realip module, which sets $remote_addr from it (nginx.org ngx_http_realip_module;
    # MDN X-Forwarded-For, "Security and privacy concerns").
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # Embedded documentation site (served from docs container)
    # Allows offline/corporate users to read docs without leaving the app
    location /docs/ {
        proxy_pass http://docs:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Frontend SPA (Svelte application)
    # Handles all routes not matched by other locations
    # Internal container port is 8080 (external host port is 5173)
    location / {
        proxy_pass http://frontend:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # SPA routing - let frontend handle 404s for client-side routes
        proxy_intercept_errors off;
    }

    # Backend WebSocket endpoint (real-time notifications)
    # IMPORTANT: Must be defined BEFORE /api/ to match first
    location /api/ws {
        proxy_pass http://backend:8080/api/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # proxy_set_header is an ARRAY directive: declaring Upgrade/Connection above
        # discards EVERY server-level proxy_set_header for this location. Without the
        # five restated below, the backend saw nginx's $proxy_host default
        # (Host: backend:8080), no forwarded scheme, and the CLIENT's own forged
        # X-Real-IP / X-Forwarded-For passed straight through. The first two make
        # api/websockets._request_origin() reconstruct backend:8080 instead of the
        # address the browser used, so the #903 same-origin gate refused every
        # legitimate handshake in this deployment mode.
        #
        # $http_host, not $host: $host drops the :port, and the same-origin
        # comparison is against a browser Origin that carries one.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;

        # WebSocket-specific timeouts
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;

        # Disable buffering for real-time communication
        proxy_buffering off;
    }

    # Backend SSE download stream (Server-Sent Events for async downloads)
    # IMPORTANT: Must be defined BEFORE /api/ so the regex matches first.
    # SSE requires buffering OFF so progress/ready events reach the browser
    # immediately instead of being held until the response closes.
    location ~ ^/api/files/(.+/download-stream|bulk-export-stream)$ {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # Prometheus metrics: internal-network only. Prometheus scrapes the backend
    # directly over the compose network; the public reverse proxy must never
    # expose /metrics. Return 404 (not 403) so the endpoint's existence isn't
    # advertised. Note: /health/ready is intentionally NOT proxied or denied — it
    # is not under /api/ so nginx never routes it to the backend anyway.
    location = /metrics {
        deny all;
        return 404;
    }
    location = /metrics/queues {
        deny all;
        return 404;
    }

    # Alertmanager webhook (issue #791): a POST fans out to every admin, so it is
    # bearer-authenticated by the backend AND unreachable from outside. Alertmanager
    # reaches backend:8080 directly over the compose network, never through here.
    # ^~ so no regex location can take precedence over the deny.
    location ^~ /internal/ {
        deny all;
        return 404;
    }

    # API-mediated media upload (POST /api/files): the one API route that carries a
    # file body. 15G matches MAX_UPLOAD_BYTES's default; the backend enforces the
    # configured ceiling while the body streams.
    location = /api/files {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;

        client_max_body_size 15G;
        proxy_request_buffering off;

        proxy_read_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
    }

    # Backend REST API
    location /api/ {
        proxy_pass http://backend:8080/api/;
        proxy_http_version 1.1;

        # JSON/form bodies only; uploads use the location above or /s3/.
        client_max_body_size 10m;
        proxy_request_buffering off;

        # Extended timeouts for long transcription operations
        proxy_read_timeout 600s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 600s;
    }

    # Flower dashboard (Celery task monitoring)
    # ^~ so the SPA's static-asset regex locations can never steal Flower's own
    # .js/.css (the bug class that broke the docs container).
    location ^~ /flower/ {
        # Admin-only. The subrequest hits the backend, which authenticates the
        # httpOnly session cookie and answers 200 for admin/super_admin, 401
        # otherwise. Flower exposes task names and arguments (file and user IDs)
        # plus worker topology, so it must not be readable by every logged-in
        # user — and the Basic-Auth injection below would otherwise hand the
        # dashboard to anyone who can load the origin.
        auth_request /api/auth/flower-authz;

        # No URI part: the request URI (/flower/...) passes unchanged, as before.
        set $flower_upstream flower:5555;
        proxy_pass http://$flower_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_redirect off;

        # Inject Flower Basic Auth credentials automatically so users don't see
        # a browser auth dialog when opening the dashboard from the app UI.
        # FLOWER_AUTH_B64 is computed at nginx startup as base64(FLOWER_USER:FLOWER_PASSWORD).
        proxy_set_header Authorization "Basic ${FLOWER_AUTH_B64}";

        # WebSocket/SSE support for Flower's real-time task event stream
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_buffering off;
    }

    # MinIO Console (S3 storage management)
    location /minio/ {
        proxy_pass http://minio:9001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # The console uploads objects through this location.
        client_max_body_size 15G;

        # MinIO requires these for proper console operation
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support for MinIO console
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # MinIO API endpoint (for presigned URLs and direct S3 operations)
    location /s3/ {
        proxy_pass http://minio:9000/;
        proxy_http_version 1.1;

        # IMPORTANT: MinIO presigned URLs are signed with 'minio:9000' as the host
        # Must match exactly what the minio_client was initialized with
        proxy_set_header Host "minio:9000";

        # Large file uploads to MinIO (15GB, matching MAX_UPLOAD_BYTES)
        client_max_body_size 15G;
        proxy_request_buffering off;

        # Stream large media downloads straight through instead of buffering them
        # to temp files (presigned video/audio downloads can be multi-GB).
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
