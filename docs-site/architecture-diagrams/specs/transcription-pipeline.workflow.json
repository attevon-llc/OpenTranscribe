      { "id": "plan", "label": "One decision point", "focus": ["backend", "dispatch", "transcribe", "poststage", "voiceprints"], "note": "dispatch.py resolves pipeline_plan once, refuses blocking issues before queueing, and every stage reads that plan." },
      { "id": "speakers", "label": "Speaker detection paths", "focus": ["transcribe", "postprocess", "poststage", "voiceprints", "index"], "note": "Speakers inline in the transcribe task, or in a post stage after the transcript is saved. Voiceprints always run here." }
    ]
  },
