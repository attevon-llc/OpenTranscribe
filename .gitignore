backend/whisperx-test.py
transcript_readable.txt

# Pipeline debug data (saved by PIPELINE_DEBUG_DIR)
debug_data/
pipeline_debug/

# Fonts (downloaded during build)
frontend/public/fonts/
frontend/static/fonts/

