  "cards": [
    {
      "dot": "cyan",
      "title": "Web tier",
      "items": [
        "SvelteKit SPA, httpOnly-cookie auth, no JS-readable token",
        "Nginx terminates TLS, proxies /api and /ws",
        "Frontend media reads/writes go via presigned MinIO URLs — the backend only generates the presign URL string, Celery workers do the actual streaming"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend + async pipeline",
      "items": [
        "FastAPI routers under backend/app/api",
        "Celery queues gpu, cpu, cpu-transcribe, cloud-asr, nlp, embedding, redaction, utility, download; the pipeline plan picks the transcription and speaker queues per file",
        "Transcription: local faster-whisper or a cloud vendor; speakers: this server, pyannote.ai or a vendor; voiceprints always on this server"
      ]
    },
    {
      "dot": "rose",
      "title": "Data + retrieval",
      "items": [
        "Postgres is system of record",
        "OpenSearch does hybrid/neural transcript search",
        "MinIO holds original media + derived artifacts",
        "Lite image: no local transcription or speaker detection, so the cloud vendors become required; voiceprints still run here on the CPU"
      ]
    }
  ]
