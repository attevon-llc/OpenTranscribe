  "cards": [
    { "dot": "cyan", "title": "One plan per run", "items": ["services/pipeline_plan.py decides engine, queue, merge and voiceprint step for every transcription x speaker-detection combination", "tasks/transcription/dispatch.py _plan_for_dispatch refuses a blocking issue (fixed sentence) before any task is published"] },
    { "dot": "rose", "title": "Where speakers come from", "items": ["Inline: local engine in the gpu task, the cloud vendor's own labels, or a cloud diarizer alongside cloud ASR", "Post stage (rediarize_task): this server on gpu, or pyannote.ai / another vendor on cloud-asr; finalize_segments re-splits", "One merge: assign_speakers, word or segment granularity; models with no timestamps are refused, no forced alignment"] },
    { "dot": "emerald", "title": "Voiceprints never leave", "items": ["inline_native: vectors from the local engine, matched in postprocess", "embedding_stage: services/voiceprint_extractor.py on the cpu queue after any other detector", "Each stage records what ran in media_file.processing_provenance (file_provenance.record_stage)"] }
