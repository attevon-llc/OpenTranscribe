# OpenTranscribe — environment template
#
# Copy to .env and replace every CHANGE_ME. The installers generate secrets for you.
#
# THIS FILE IS FOR SECRETS AND SYSTEM CONFIG ONLY.
# Auth, ASR/LLM providers, redaction policy and watch sources are configured in
# the ADMIN UI and stored in the database — a UI value always wins over this file.
#
# Every variable, its default, and the optional settings NOT listed here:
#   docs-site/docs/configuration/environment-variables.md
# Local test containers (LDAP/Keycloak/Authentik/monitoring):  .env.test.example

#--- SECRETS — replace every CHANGE_ME before exposing this deployment ---------
POSTGRES_PASSWORD=CHANGE_ME_auto_generated_on_install
# production REFUSES TO BOOT if unset
REDIS_PASSWORD=CHANGE_ME_auto_generated_on_install
MINIO_ROOT_PASSWORD=CHANGE_ME_auto_generated_on_install
MINIO_KMS_SECRET_KEY=CHANGE_ME_auto_generated_on_install
OPENSEARCH_PASSWORD=CHANGE_ME_auto_generated_on_install
OPENSEARCH_ADMIN_PASSWORD=
# production REFUSES TO BOOT on the placeholder
JWT_SECRET_KEY=CHANGE_ME_auto_generated_on_install
# decrypts every DB-stored secret — NEVER change after first use
ENCRYPTION_KEY=CHANGE_ME_auto_generated_on_install
FLOWER_PASSWORD=CHANGE_ME_auto_generated_on_install
HUGGINGFACE_TOKEN=
SMTP_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

#--- CORE SERVICES -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_DB=opentranscribe
POSTGRES_SSLMODE=prefer
REDIS_HOST=redis
REDIS_USE_TLS=false
MINIO_HOST=minio
MINIO_ROOT_USER=minioadmin
MINIO_SECURE=false
MEDIA_BUCKET_NAME=opentranscribe
MINIO_KMS_AUTO_ENCRYPTION=on
OPENSEARCH_HOST=opensearch
OPENSEARCH_USER=admin
OPENSEARCH_USE_TLS=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_AUTH=basic
OPENSEARCH_AWS_REGION=
OPENSEARCH_AWS_SERVICE=es
OPENSEARCH_DISABLE_SECURITY=true

#--- PORTS (host-side) ---------------------------------------------------------
FRONTEND_PORT=5173          # Web UI
BACKEND_PORT=5174           # API Server
FLOWER_PORT=5175            # Celery Task Monitor
POSTGRES_PORT=5176          # Database (for admin tools)
REDIS_PORT=5177             # Redis (for debugging)
MINIO_PORT=5178             # MinIO API
MINIO_CONSOLE_PORT=5179     # MinIO Web Console
OPENSEARCH_PORT=5180        # OpenSearch API
OPENSEARCH_ADMIN_PORT=5181  # OpenSearch Admin
DOCS_PORT=5183              # Embedded documentation site (proxied at /docs/ in-app)

#--- STORAGE -------------------------------------------------------------------
STORAGE_BACKEND=minio
MINIO_PUBLIC_URL=
STORAGE_PUBLIC_URL=
MEDIA_URL_EXPIRE_SECONDS=21600   # 6h
PRESIGNED_URL_MAX_SECONDS=21600  # 6h
MULTIPART_THRESHOLD_MB=512
MODEL_CACHE_DIR=./models
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_USE_IAM_ROLE=true
S3_CONFIGURE_BUCKET_CORS=false
S3_CORS_ALLOWED_ORIGINS=

#--- SEARCH --------------------------------------------------------------------
OPENSEARCH_NEURAL_SEARCH_ENABLED=true
# changing this forces a FULL REINDEX
OPENSEARCH_NEURAL_MODEL=huggingface/sentence-transformers/all-MiniLM-L6-v2
OPENSEARCH_NEURAL_PIPELINE=transcript-neural-ingest
OPENSEARCH_EMBEDDING_MODE=local
OPENSEARCH_NEURAL_MODEL_ID=

#--- GPU AND TRANSCRIPTION -----------------------------------------------------
# which physical GPU to use
GPU_DEVICE_ID=0
GPU_CONCURRENT_REQUESTS=1
GPU_SCALE_ENABLED=false
GPU_SCALE_DEVICE_ID=2
GPU_SCALE_WORKERS=4
GPU_SCALE_DEFAULT_WORKER=1
GPU_TRANSCRIBE_DEVICE_ID=0  # host CUDA device for gpu-transcribe worker (WhisperX)
GPU_DIARIZE_DEVICE_ID=1     # host CUDA device for gpu-diarize worker (PyAnnote)
FFMPEG_THREADS=0
# also settable in the admin UI, which wins
WHISPER_MODEL=large-v3-turbo
ENABLE_DIARIZATION=true
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
MIN_SPEAKERS=1
MAX_SPEAKERS=20  # Can be increased to 50+ for large conferences (no hard limit)
ENABLE_VRAM_PROFILING=false
DEPLOYMENT_MODE=full
BACKEND_LITE_IMAGE=davidamacey/opentranscribe-backend-lite:latest
ENGINE_TRANSCRIBER_BACKEND=faster_whisper  # faster_whisper | whisperx | cloud
ENGINE_DIARIZER_BACKEND=native
ENGINE_GPU_SPLIT=false
ENGINE_SHARED_VOLUME_PATH=/tmp/transcription  # internal cross-stage WAV handoff dir (split path)

#--- AI PROVIDERS — per-user config lives in the UI; these are only the fallback
LLM_PROVIDER=
# MUST be true for local vLLM/Ollama; false on multi-tenant
LLM_ALLOW_PRIVATE_ENDPOINTS=false
ASR_PROVIDER=local
AWS_REGION=us-east-1

#--- SECURITY ------------------------------------------------------------------
# FAIL-CLOSED: unset or unknown = production
# ENVIRONMENT=production
# true (default) self-hosts; false for K8s/ECS where a migrate Job owns migrations
# RUN_MIGRATIONS_ON_STARTUP=true
# 15 GB, matching the UI. 0 disables the limit.
# MAX_UPLOAD_BYTES=16106127360
# false when an IdP owns identity. DB-backed at Settings -> Authentication.
# ALLOW_OPEN_REGISTRATION=true
JWT_ALGORITHM=HS256
RATE_LIMIT_API_PER_MINUTE=100
# leave empty unless you add your own proxy
RATE_LIMIT_TRUSTED_PROXIES=
# REQUIRED in production — every mailed credential link is built from it
FRONTEND_URL=http://localhost:5173
ABUSE_CONTACT_EMAIL=
PKI_ENABLED=false
# empty = reject every header identity (fail-closed boot guard)
PKI_TRUSTED_PROXIES=
PROXY_ENABLED=false
# empty = reject every header identity (fail-closed boot guard)
PROXY_TRUSTED_PROXIES=
PKI_OCSP_CACHE_MAX_SIZE=1000
PKI_CRL_CACHE_MAX_SIZE=1000

#--- COMPLIANCE — env-only by necessity; see the docs for what each enforces ---
FIPS_MODE=false
PBKDF2_ITERATIONS=210000
TOKEN_REVOCATION_ENABLED=true
AUDIT_LOG_ENABLED=true
AUDIT_LOG_FORMAT=json
AUDIT_LOG_TO_OPENSEARCH=true
AUDIT_LOG_RETENTION_DAYS=365

#--- MAIL — prefer the Admin UI (Settings -> Watch Sources -> Email Configurations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=noreply@yourdomain.com
SMTP_USE_TLS=true

#--- REDACTION — worker/model hosting only; policy is set in the UI ------------
REDACTION_DEVICE=auto            # auto | cpu | cuda — compute device for redaction ML models
REDACTION_GPU_DEVICE_ID=         # spare GPU id for redaction models when REDACTION_DEVICE=cuda
REDACTION_MIN_FREE_VRAM_GB=1.5   # free-VRAM floor before redaction worker uses GPU
REDACTION_CONCURRENCY=2          # redaction worker concurrency
REDACTION_TORCH_THREADS=8        # caps OMP/MKL threads for the redaction worker
REDACTION_NICE=10                # OS nice priority for the redaction worker
REDACTION_PII_USE_GLINER=false   # use GLiNER for PII NER (slower, more accurate) vs spaCy NER

#--- YOUTUBE INGESTION ---------------------------------------------------------
YOUTUBE_COOKIE_BROWSER=
YOUTUBE_COOKIE_FILE=
YOUTUBE_PLAYLIST_STAGGER_ENABLED=true
YOUTUBE_PLAYLIST_STAGGER_MIN_SECONDS=5    # Minimum delay between videos
YOUTUBE_PLAYLIST_STAGGER_MAX_SECONDS=30   # Maximum delay (caps at this value)
YOUTUBE_PLAYLIST_STAGGER_INCREMENT=5      # Delay increases by this amount per video
YOUTUBE_PRE_DOWNLOAD_JITTER_ENABLED=true
YOUTUBE_PRE_DOWNLOAD_JITTER_MIN_SECONDS=2   # Minimum random delay
YOUTUBE_PRE_DOWNLOAD_JITTER_MAX_SECONDS=15  # Maximum random delay
YOUTUBE_USER_RATE_LIMIT_ENABLED=true
YOUTUBE_USER_RATE_LIMIT_PER_HOUR=50   # Maximum downloads per user per hour
YOUTUBE_USER_RATE_LIMIT_PER_DAY=500   # Maximum downloads per user per day
YOUTUBE_RECOVERY_BATCH_SIZE=3
YOUTUBE_AUTO_RETRY_ENABLED=true
YOUTUBE_DOWNLOAD_RATE_LIMIT=30/h

#--- FRONTEND ------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5174/api
VITE_FLOWER_URL_PREFIX=flower
FLOWER_USER=admin
FLOWER_URL_PREFIX=flower

#--- LOGGING -------------------------------------------------------------------
LOG_FORMAT=text
SLOW_QUERY_MS=500
SETTINGS_CACHE_TTL=30
READ_CACHE_ENABLED=true

#--- HOST PATHS — only used by the matching ./opentr.sh --with-* overlay -------
WATCH_HOST_PATH=./watch
BACKUP_HOST_PATH=./backups
BACKUP_MIRROR_HOST_PATH=./media-mirror
