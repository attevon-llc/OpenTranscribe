FROM node:26-alpine
# npm's update-notifier phones registry.npmjs.org for a newer npm on every run; off.
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /app

# su-exec is all the entrypoint needs. python3/make/g++/git were installed here since the initial
# commit but nothing uses them: package-lock.json's only hasInstallScript package is the optional,
# macOS-only fsevents, and there are no git dependencies (a native dep would fail loudly at npm ci).
RUN apk add --no-cache su-exec

# Install dependencies as `node` (uid 1000, the default dev owner) so the image's node_modules is
# already owned by the uid the entrypoint would chown it to: Docker populates a fresh anonymous
# volume from the image keeping ownership, so the entrypoint's recursive chown is skipped (#1372).
# /app is empty here, so this chown touches one directory entry, not a layer of files.
RUN chown node:node /app
COPY --chown=node:node package.json package-lock.json ./

# `npm ci` installs exactly the lockfile and never rewrites it; the cache mount keeps downloads
# between builds and is not committed to the image (Docker docs: Optimize cache usage).
# `su-exec node` (not a USER line) keeps the image ending as root, which the entrypoint needs to repair
# reused volumes before it drops privileges; su-exec does not set HOME, so npm gets it explicitly.
RUN --mount=type=cache,target=/home/node/.npm,uid=1000,gid=1000 \
    HOME=/home/node su-exec node:node npm ci \
    && su-exec node:node mkdir -p .svelte-kit

# Create static directory for fonts
RUN mkdir -p static/fonts

# Copy application code
COPY . .

# Ownership of reused node_modules / .svelte-kit volumes is repaired by the entrypoint at start,
# not here: a recursive chown in a build layer copies every file into a new layer (#1372).
COPY docker-entrypoint.dev.sh /usr/local/bin/docker-entrypoint.dev.sh
RUN chmod 755 /usr/local/bin/docker-entrypoint.dev.sh

# Expose port 5173 for Vite dev server
EXPOSE 5173

# Starts as root only to repair volume ownership, then su-execs to the bind-mount owner.
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.dev.sh"]
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
