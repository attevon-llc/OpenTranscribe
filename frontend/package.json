{
  "name": "opentranscribe-frontend",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "prebuild": "node scripts/download-fonts.js",
    "build:analyze": "node scripts/download-fonts.js && ANALYZE=true vite build && node -e \"require('fs').copyFileSync('.bundle-stats/stats.html','dist/stats.html')\" && echo \"bundle report: dist/stats.html\"",
    "deadcode": "knip",
    "cycles": "madge --circular --extensions ts,js,svelte --ts-config tsconfig.json src",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "setup-fonts": "node scripts/download-fonts.js",
    "test:offline": "node scripts/serve-offline.js",
    "pretest": "svelte-kit sync",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:i18n": "node scripts/check-i18n-parity.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@svelte-plugins/datepicker": "^1.0.11",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "madge": "^8.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "svelte": "~5.55.5",
    "svelte-check": "^4.7.3",
    "svelte-eslint-parser": "^1.8.0",
    "svelte-range-slider-pips": "^4.1.1",
    "tslib": "^2.6.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@types/dompurify": "^3.2.0",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "devalue": "^5.8.2",
    "dompurify": "^3.4.12",
    "fuse.js": "^7.5.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "imohash": "^1.0.3",
    "plyr": "^3.8.4",
    "svelte-loading-spinners": "^0.3.6",
    "svelte-multiselect": "^11.8.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "serialize-javascript": "^7.0.3"
  }
}
